{
  "$ref": "#/definitions/DesignQaVerdict",
  "definitions": {
    "DesignQaVerdict": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "needs_revision"
          ]
        },
        "overallScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "enum": [
                  "CONTRAST",
                  "SPACING_GRID",
                  "TAP_TARGET",
                  "TYPOGRAPHY_SCALE",
                  "ACCESSIBILITY",
                  "LAYOUT_OVERFLOW",
                  "FOCUS_VISIBLE",
                  "AI_SLOP_COLOR",
                  "GRADIENT_TEXT",
                  "DARK_GLOW",
                  "SIDE_TAB_BORDER",
                  "GRAY_ON_COLOR",
                  "NESTED_CARDS",
                  "ICON_TILE_STACK",
                  "BANNED_EYEBROW",
                  "EMOJI_ICON",
                  "FLAT_TYPE_HIERARCHY",
                  "HEADING_RHYTHM",
                  "LINE_LENGTH",
                  "CRAMPED_PADDING",
                  "TEXT_OCCLUSION",
                  "CLIPPED_OVERFLOW",
                  "BROKEN_IMAGE",
                  "HIDDEN_AT_REST",
                  "COLUMN_OVERFLOW",
                  "DESIGN_SYSTEM_DRIFT",
                  "PENPOT_TOKEN"
                ]
              },
              "element": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "warning",
                  "info",
                  "advisory"
                ]
              },
              "recommendation": {
                "type": "string"
              },
              "cssFix": {
                "type": "string"
              },
              "suggestedCommand": {
                "type": "string"
              },
              "cropImagePath": {
                "type": "string"
              }
            },
            "required": [
              "rule",
              "element",
              "severity",
              "recommendation",
              "cssFix"
            ],
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedImpeccableCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedTailwindCss": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "verdict",
        "overallScore",
        "violations",
        "recommendations"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}