{
  "$ref": "#/definitions/RegressionVerdict",
  "definitions": {
    "RegressionVerdict": {
      "type": "object",
      "properties": {
        "testId": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "bug",
            "intentional_change",
            "flaky_subpixel_noise"
          ]
        },
        "rootCause": {
          "type": "string"
        },
        "affectedComponents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedFix": {
          "type": "string"
        },
        "crossViewportSummary": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "testId",
        "verdict",
        "rootCause",
        "affectedComponents",
        "suggestedFix",
        "crossViewportSummary",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}