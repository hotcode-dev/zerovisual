---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import ImageCompare from '../components/ImageCompare.astro';
import TokenCalculator from '../components/TokenCalculator.astro';
import '../styles/custom.css';
---

<StarlightPage
  frontmatter={{
    title: 'ZeroVisual',
    description: 'Zero-waste, zero-API-key visual regression and automated UI design QA pre-processor for AI Agents.',
    template: 'splash',
    head: [
      { tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
    ],
    hero: {
      tagline: 'Cut Vision LLM token spend by up to 90% and shrink screenshot payloads by 99%—100% locally, with zero AI API keys.',
      actions: [
        { text: 'Get Started', link: '/guides/getting-started/', icon: 'right-arrow' },
        { text: 'Explore Benchmarks (-85.1% ViT)', link: '/guides/benchmarks/', variant: 'secondary' },
      ],
    },
  }}
>
  <div class="not-content space-y-16">
    <!-- Section 1: Real-World Visual Regression Comparison -->
    <section aria-labelledby="showcase-heading">
      <ImageCompare />
    </section>

    <!-- Section 2: Interactive Token & Byte Savings Calculator -->
    <section aria-labelledby="calculator-heading">
      <TokenCalculator />
    </section>

    <!-- Section 3: Benchmark Explorer Callout -->
    <section aria-labelledby="benchmark-callout-heading">
      <div class="zv-callout-banner">
        <div class="space-y-2 max-w-2xl">
          <h2 id="benchmark-callout-heading" class="text-xl sm:text-2xl font-bold text-slate-50 tracking-tight m-0">
            Interactive Benchmark &amp; AI Session Explorer
          </h2>
          <p class="text-base text-slate-300 leading-relaxed m-0">
            Inspect side-by-side screenshots (Baseline, Actual, Diff, Crop) across 11 live website scenarios (Wikipedia, Hacker News, GitHub, MDN) and examine real VLM reasoning traces (<code>&lt;think&gt;</code>) and token metrics on <code>RadixArk/Qwen3.8-27B-NVFP4</code>.
          </p>
        </div>
        <a
          href="/guides/benchmarks/"
          class="zv-cta-button"
        >
          <span>Launch Benchmark Explorer</span>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- Section 4: Core Capabilities -->
    <section aria-labelledby="capabilities-heading" class="pt-4 border-t border-slate-800/80">
      <div class="mb-6">
        <h2 id="capabilities-heading" class="text-2xl sm:text-3xl font-bold text-slate-50 tracking-tight m-0">
          Why ZeroVisual?
        </h2>
      </div>
      <CardGrid>
        <Card title="Zero API Keys Required (BYOA)" icon="key">
          Runs 100% locally on your machine or CI/CD runner. Outputs structured JSON and model-aligned WebP artifacts for your coding agent via 1-command Skills + Scripts.
        </Card>
        <Card title="Model-Aware Grid Math" icon="setting">
          Aligns failure diffs to exact Vision Transformer grids: 512px for OpenAI, 504px for Anthropic (28px patches), 768px/384px for Gemini, and 448px for Local models.
        </Card>
        <Card title="Multi-Viewport Aggregation" icon="laptop">
          Correlates broken layouts across Desktop, Tablet, and Mobile viewports under a single normalized <code>testId</code> so your agent diagnoses breakpoint bugs in one prompt.
        </Card>
        <Card title="Scoped Semantic Context" icon="document">
          Captures the component's Playwright <code>ariaSnapshot</code> YAML and 31 computed layout &amp; visual CSS properties instead of dumping 100,000+ characters of raw HTML.
        </Card>
        <Card title="Rendered Anti-Slop + DESIGN.md" icon="pencil">
          Catches 26 deterministic DOM rules—including rendered AI slop (gradient text, violet gradients, glow halos, side-tab borders, nested cards, eyebrows), WCAG 2.1 AA contrast, 8pt grid, and native <code>DESIGN.md</code> / Penpot drift.
        </Card>
        <Card title="Clustered Violation Crops &amp; Impeccable Routing" icon="star">
          Crops up to 4 clustered 1-tile <code>.webp</code> defect snapshots per viewport (even below the fold) and routes every violation directly to its target <code>/impeccable</code> command.
        </Card>
      </CardGrid>
    </section>

    <!-- Section 4b: Rendered Anti-Slop & Impeccable Companion -->
    <section aria-labelledby="antislop-heading" class="pt-4 border-t border-slate-800/80">
      <div class="mb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 id="antislop-heading" class="text-2xl sm:text-3xl font-bold text-slate-50 tracking-tight m-0">
            Rendered Anti-Slop Engine + Impeccable Companion
          </h2>
          <p class="text-base text-slate-400 mt-2 max-w-3xl">
            Static source linters cannot see actual bounding boxes, computed gradients, or below-the-fold overflow. ZeroVisual audits the live rendered browser DOM at 0 AI tokens, crops clustered defects into 1-tile WebPs, and maps fixes to <strong>Impeccable</strong> commands.
          </p>
        </div>
        <a
          href="/guides/with-impeccable/"
          class="zv-cta-button shrink-0"
        >
          <span>Impeccable Integration Guide</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 my-6">
        <div class="p-5 rounded-xl bg-[#0f141e] border border-[#1e2736] space-y-2">
          <h3 class="text-base font-bold text-slate-100 m-0">1. Kill AI Palette &amp; Glow Tells</h3>
          <p class="text-sm text-slate-400 leading-relaxed m-0">
            Detects <code>GRADIENT_TEXT</code>, <code>AI_SLOP_COLOR</code> (purple/violet gradients), <code>DARK_GLOW</code> (chromatic halos &amp; radial spotlights), <code>SIDE_TAB_BORDER</code>, and <code>GRAY_ON_COLOR</code>.
          </p>
          <div class="pt-1 text-xs font-mono text-cyan-400">→ /impeccable colorize · quieter · distill</div>
        </div>

        <div class="p-5 rounded-xl bg-[#0f141e] border border-[#1e2736] space-y-2">
          <h3 class="text-base font-bold text-slate-100 m-0">2. Break Template Reflexes</h3>
          <p class="text-sm text-slate-400 leading-relaxed m-0">
            Flags <code>NESTED_CARDS</code> (card-in-card), <code>ICON_TILE_STACK</code> (3-column icon-box above heading grids), <code>BANNED_EYEBROW</code> (kicker pills &amp; <code>01/02/03</code> badges), and <code>EMOJI_ICON</code>.
          </p>
          <div class="pt-1 text-xs font-mono text-cyan-400">→ /impeccable distill · layout · polish</div>
        </div>

        <div class="p-5 rounded-xl bg-[#0f141e] border border-[#1e2736] space-y-2">
          <h3 class="text-base font-bold text-slate-100 m-0">3. Enforce Hierarchy &amp; Measure</h3>
          <p class="text-sm text-slate-400 leading-relaxed m-0">
            Verifies <code>FLAT_TYPE_HIERARCHY</code> (&ge;1.25&times; scale), <code>HEADING_RHYTHM</code> (space above &gt; space below), <code>LINE_LENGTH</code> (65–75ch &amp; viewport gutters), <code>CRAMPED_PADDING</code>, and 8pt <code>SPACING_GRID</code>.
          </p>
          <div class="pt-1 text-xs font-mono text-cyan-400">→ /impeccable typeset · layout</div>
        </div>

        <div class="p-5 rounded-xl bg-[#0f141e] border border-[#1e2736] space-y-2">
          <h3 class="text-base font-bold text-slate-100 m-0">4. Live DOM + DESIGN.md Drift</h3>
          <p class="text-sm text-slate-400 leading-relaxed m-0">
            Catches <code>TEXT_OCCLUSION</code>, <code>CLIPPED_OVERFLOW</code>, <code>BROKEN_IMAGE</code>, <code>HIDDEN_AT_REST</code>, <code>COLUMN_OVERFLOW</code>, and auto-checks live styles against <code>DESIGN.md</code> (&ldquo;the brief wins&rdquo;).
          </p>
          <div class="pt-1 text-xs font-mono text-cyan-400">→ /impeccable adapt · harden · polish</div>
        </div>
      </div>
    </section>

    <!-- Section 5: Token & Payload Efficiency -->
    <section aria-labelledby="efficiency-heading" class="pt-4 border-t border-slate-800/80">
      <div class="mb-6">
        <h2 id="efficiency-heading" class="text-2xl sm:text-3xl font-bold text-slate-50 tracking-tight m-0">
          Token &amp; Payload Efficiency
        </h2>
        <p class="text-base text-slate-400 mt-1">
          Raw Full-HD PNG (1920×1080) vs. ZeroVisual Model-Aligned WebP
        </p>
      </div>

      <div class="overflow-x-auto my-6">
        <table>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Raw Full-HD PNG (1920×1080)</th>
              <th scope="col">ZeroVisual WebP (<code>quality: 80</code>)</th>
              <th scope="col">Engineering Advantage</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-semibold text-slate-100">Vision LLM Tokens</td>
              <td class="tabular-nums">~1,600 – 2,691 tokens / viewport</td>
              <td class="font-semibold text-emerald-400 tabular-nums">~28 – 324 tokens / viewport</td>
              <td class="font-medium text-emerald-300">Up to ~90% token savings (fits 1-tile grid)</td>
            </tr>
            <tr>
              <td class="font-semibold text-slate-100">Payload Size</td>
              <td class="tabular-nums">~4,000 KB (5.3 MB Base64)</td>
              <td class="font-semibold text-emerald-400 tabular-nums">~35 KB (~47 KB Base64)</td>
              <td class="font-medium text-emerald-300">99% byte reduction (instant IPC &amp; upload)</td>
            </tr>
            <tr>
              <td class="font-semibold text-slate-100">JSON Parse Time</td>
              <td class="tabular-nums">~100 – 300 ms (pipe congestion)</td>
              <td class="font-semibold text-emerald-400 tabular-nums">&lt; 1 ms</td>
              <td class="font-medium text-emerald-300">Zero UI lag or event loop blocking in IDE</td>
            </tr>
            <tr>
              <td class="font-semibold text-slate-100">Model UI Readability</td>
              <td>Full canvas noise</td>
              <td class="font-semibold text-emerald-400">Isolated diff box + 32px padding</td>
              <td class="font-medium text-emerald-300">Eliminates VLM hallucinations on subtle shifts</td>
            </tr>
          </tbody>
        </table>
      </div>

      <blockquote>
        <strong class="block mb-2 text-slate-100">Why Both Token Count and Network Bytes Matter</strong>
        <ol class="list-decimal pl-5 space-y-2 text-base leading-relaxed text-slate-300 m-0">
          <li><strong>Vision Tokens (Pixel Dimensions):</strong> Vision Transformers (ViTs) calculate tokens from geometric patch grids (e.g., Anthropic's 28×28px patches, OpenAI's 512×512px tiles)—not file bytes. Cropping and downscaling ensures failure diffs fit inside a <strong>single vision tile</strong>.</li>
          <li><strong>Network Bytes (Payload Size):</strong> Vision LLM API requests transfer images as Base64 strings (+33% byte expansion). Dropping images from 4 MB to 35 KB eliminates serialization bottlenecks and keeps your AI coding agent responsive.</li>
        </ol>
      </blockquote>

      <div class="mt-8 p-6 rounded-xl bg-[#0f141e] border border-[#1e2736]">
        <h3 class="text-lg font-bold text-slate-100 mb-2">
          Live Empirical Validation (Qwen 3.8 27B &amp; Live Websites)
        </h3>
        <p class="text-base text-slate-400 mb-5">
          Tested against a local Vision LLM endpoint (<code>RadixArk/Qwen3.8-27B-NVFP4</code> via SGLang) and live production websites (Wikipedia, Hacker News, GitHub, MDN) across 11 visual regression scenarios:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
          <div class="p-4 rounded-lg bg-[#090c12] border border-[#1e2736]">
            <div class="text-xs font-mono uppercase tracking-wider text-slate-400">Vision Image Tokens</div>
            <div class="text-xl font-extrabold text-emerald-400 tabular-nums mt-1">-85.1%</div>
            <div class="text-xs text-slate-400 font-mono tabular-nums mt-0.5">8,756 → 1,304 tok</div>
          </div>
          <div class="p-4 rounded-lg bg-[#090c12] border border-[#1e2736]">
            <div class="text-xs font-mono uppercase tracking-wider text-slate-400">Network Payload</div>
            <div class="text-xl font-extrabold text-cyan-400 tabular-nums mt-1">-88.8%</div>
            <div class="text-xs text-slate-400 font-mono tabular-nums mt-0.5">638.9 → 71.8 KB</div>
          </div>
          <div class="p-4 rounded-lg bg-[#090c12] border border-[#1e2736]">
            <div class="text-xs font-mono uppercase tracking-wider text-slate-400">Total Tokens</div>
            <div class="text-xl font-extrabold text-slate-100 tabular-nums mt-1">-29.7%</div>
            <div class="text-xs text-slate-400 font-mono tabular-nums mt-0.5">25,748 → 18,105 tok</div>
          </div>
          <div class="p-4 rounded-lg bg-[#090c12] border border-[#1e2736]">
            <div class="text-xs font-mono uppercase tracking-wider text-slate-400">Triage Accuracy</div>
            <div class="text-xl font-extrabold text-emerald-400 tabular-nums mt-1">+9.1%</div>
            <div class="text-xs text-slate-400 font-mono tabular-nums mt-0.5">59.1% → 68.2%</div>
          </div>
        </div>
        <a
          href="/guides/benchmarks/"
          class="inline-flex items-center gap-2 min-h-[44px] text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors no-underline"
        >
          <span>Read the full Empirical LLM Benchmark Report</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Section 6: Model Vision Grid Reference -->
    <section aria-labelledby="grid-ref-heading" class="pt-4 border-t border-slate-800/80">
      <div class="mb-6">
        <h2 id="grid-ref-heading" class="text-2xl sm:text-3xl font-bold text-slate-50 tracking-tight m-0">
          Model Vision Grid Reference
        </h2>
      </div>
      <div class="overflow-x-auto my-6">
        <table>
          <thead>
            <tr>
              <th scope="col">Provider Setting</th>
              <th scope="col">Target Max Bounding Box</th>
              <th scope="col">Vision Grid Mechanics</th>
              <th scope="col">Approx. Token Cost per Diff</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>openai</code></td>
              <td><code>512 × 512 px</code></td>
              <td>Fits inside 1 standard OpenAI <code>512px</code> tile</td>
              <td class="text-emerald-400 font-semibold tabular-nums">~85 – 255 tokens</td>
            </tr>
            <tr>
              <td><code>anthropic</code></td>
              <td><code>504 × 504 px</code></td>
              <td>Exact <code>18 × 18</code> grid of <code>28×28 px</code> patches</td>
              <td class="text-emerald-400 font-semibold tabular-nums">~28 – 324 tokens</td>
            </tr>
            <tr>
              <td><code>gemma</code> / <code>gemini</code></td>
              <td><code>768 × 768 px</code></td>
              <td>Fits 1 native Gemma / Gemini multimodal tile</td>
              <td class="text-emerald-400 font-semibold tabular-nums">~258 tokens</td>
            </tr>
            <tr>
              <td><code>gemma</code> (<code>lowTokenMode</code>)</td>
              <td><code>384 × 384 px</code></td>
              <td>Sub-384px single base tile optimization</td>
              <td class="text-emerald-400 font-semibold tabular-nums">~258 tokens (ultra-fast)</td>
            </tr>
            <tr>
              <td><code>qwen</code></td>
              <td><code>504 × 504 px</code></td>
              <td>Dynamic 2D spatial patch grid (<code>28×28 px</code>)</td>
              <td class="text-emerald-400 font-semibold tabular-nums">~28 – 324 tokens</td>
            </tr>
            <tr>
              <td><code>local</code></td>
              <td><code>448 × 448 px</code> (configurable)</td>
              <td>Optimized for local VLMs (<code>28px</code> / <code>14px</code> patch ViTs)</td>
              <td class="text-slate-300">Local compute</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .zv-callout-banner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: var(--zv-radius-lg);
    background: linear-gradient(135deg, #0f1722 0%, #0d131d 60%, rgba(16, 185, 129, 0.08) 100%);
    border: 1px solid var(--zv-border-strong);
  }

  @media (min-width: 768px) {
    .zv-callout-banner {
      flex-direction: row;
      align-items: center;
      padding: 1.75rem 2rem;
    }
  }

  .zv-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.14);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .zv-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 20px;
    border-radius: var(--zv-radius-md);
    background: #10b981;
    color: #03150e;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid #34d399;
    transition: background-color 160ms var(--zv-ease-out), transform 160ms var(--zv-ease-out);
  }

  .zv-cta-button:hover {
    background: #34d399;
    color: #03150e;
    transform: translateY(-1px);
  }

  .zv-cta-button:active {
    transform: scale(0.98);
  }
</style>
