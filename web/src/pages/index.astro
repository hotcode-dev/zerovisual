---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid } from '@astrojs/starlight/components';
import ImageCompare from '../components/ImageCompare.astro';
import TokenCalculator from '../components/TokenCalculator.astro';
---

<StarlightPage
  frontmatter={{
    title: 'ZeroVisual',
    description: 'Zero-waste, zero-API-key visual regression and automated UI design QA pre-processor for AI Agents.',
    template: 'splash',
    hero: {
      tagline: 'Cut Vision LLM token consumption by up to 90% and shrink payload bytes by 99%—without requiring a single AI API key.',
      actions: [
        { text: 'Get Started', link: '/guides/getting-started/', icon: 'right-arrow' },
        { text: 'Benchmarks (-87.7% ViT)', link: '/guides/benchmarks/', variant: 'secondary' },
        { text: 'How It Works', link: '/guides/how-it-works/', variant: 'minimal' },
        { text: 'View on GitHub', link: 'https://github.com/hotcode-dev/zerovisual', icon: 'external', variant: 'minimal' },
      ],
    },
  }}
>
  <div class="not-content">
    <ImageCompare />

  <TokenCalculator />

  <div class="divider my-12 border-slate-800"></div>

  <section class="my-12">
    <h2 class="text-3xl font-extrabold text-slate-100 tracking-tight mb-8">🎯 Why ZeroVisual?</h2>
    <CardGrid stagger>
      <Card title="Zero API Keys Required (BYOA)" icon="key">
        ZeroVisual never calls LLM APIs directly. It runs 100% locally on your machine or CI/CD runner and outputs structured JSON or serves tools via standard MCP over stdio.
      </Card>
      <Card title="Model-Aware Grid Math" icon="setting">
        Aligns failure diffs to exact Vision Transformer grids: 512px for OpenAI, 504px for Anthropic (28px patches), 768px/384px for Gemini, and 448px for Local models.
      </Card>
      <Card title="Multi-Viewport Aggregation" icon="laptop">
        Correlates broken layouts across Desktop, Tablet, and Mobile viewports under a single normalized <code>testId</code>. Your AI agent diagnoses the breakpoint bug in one single prompt.
      </Card>
      <Card title="Scoped Semantic Context" icon="document">
        Captures the component's Playwright <code>ariaSnapshot</code> YAML and 14 computed layout CSS properties instead of dumping 100,000+ characters of raw HTML.
      </Card>
      <Card title="Heuristic UI Linter + Penpot" icon="pencil">
        Objective math checks for WCAG 2.1 AA contrast ratios, 8pt spacing rhythm, and 44px tap targets, plus native SVG/JSON token diffing for open-source Penpot designs.
      </Card>
      <Card title="Dual Isolated Agent Skills" icon="star">
        Separate <code>zerovisual-regression</code> (strict triage forensics) and <code>zerovisual-design-qa</code> (UI/UX coaching) skills to prevent prompt pollution and hallucinations.
      </Card>
    </CardGrid>
  </section>

  <div class="divider my-12 border-slate-800"></div>

  <section class="my-12">
    <h2 class="text-3xl font-extrabold text-slate-100 tracking-tight mb-4">📊 Token & Payload Efficiency</h2>
    <h3 class="text-xl font-bold text-slate-200 mb-6">Raw Full-HD PNG vs. ZeroVisual Model-Aligned WebP</h3>

    <div class="overflow-x-auto my-6">
      <table class="table w-full rounded-xl overflow-hidden border border-slate-700/60 bg-slate-900/60 backdrop-blur-md">
        <thead>
          <tr class="bg-slate-800/90 text-slate-100 uppercase text-xs tracking-wider">
            <th>Metric</th>
            <th>Raw Full-HD PNG (1920×1080)</th>
            <th>ZeroVisual WebP (<code>quality: 80</code>)</th>
            <th>Engineering Advantage</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="font-bold text-slate-200">Vision LLM Tokens</td>
            <td>~1,600 – 2,691 tokens / viewport</td>
            <td class="font-bold text-emerald-400">~28 – 324 tokens / viewport</td>
            <td class="font-bold text-emerald-400">Up to ~90% token savings (crops & fits exact 1-tile grid)</td>
          </tr>
          <tr>
            <td class="font-bold text-slate-200">Payload Size</td>
            <td>~4,000 KB (5.3 MB Base64)</td>
            <td class="font-bold text-emerald-400">~35 KB (~47 KB Base64)</td>
            <td class="font-bold text-emerald-400">99% byte reduction (instant IPC & network upload)</td>
          </tr>
          <tr>
            <td class="font-bold text-slate-200">JSON Parse Time</td>
            <td>~100–300 ms (pipe congestion)</td>
            <td class="font-bold text-emerald-400">&lt; 1 ms</td>
            <td class="font-bold text-emerald-400">Zero UI lag or event loop blocking in IDE</td>
          </tr>
          <tr>
            <td class="font-bold text-slate-200">Model UI Readability</td>
            <td>Full canvas noise</td>
            <td class="font-bold text-emerald-400">Isolated diff bounding box + 32px padding</td>
            <td class="font-bold text-emerald-400">Eliminates VLM hallucinations on subtle UI shifts</td>
          </tr>
        </tbody>
      </table>
    </div>

    <blockquote class="border-l-4 border-indigo-500 bg-gradient-to-r from-indigo-950/50 to-slate-900/80 rounded-r-xl p-5 my-6 text-slate-300">
      <strong class="text-indigo-100 font-semibold block mb-2">Why Both Token Count and Network Bytes Matter:</strong>
      <ol class="list-decimal pl-5 space-y-2 text-sm leading-relaxed">
        <li><strong>Vision Tokens (Pixel Dimensions):</strong> Vision Transformers (ViTs) calculate tokens based on geometric patch grids (e.g. Anthropic's 28×28px patches, OpenAI's 512×512px tiles)—not file bytes. Cropping and downscaling ensures failure diffs fit inside a <strong>single vision tile</strong>.</li>
        <li><strong>Network Bytes (Payload Size):</strong> MCP over <code>stdio</code> and HTTP API requests transfer images as Base64 strings (+33% byte expansion). Dropping images from 4 MB to 35 KB prevents Node.js JSON serialization bottlenecks and keeps your AI coding agent snappy.</li>
      </ol>
    </blockquote>

    <div class="mt-8 mb-4">
      <h3 class="text-xl font-bold text-slate-200 mb-3">🧪 Live Empirical Validation (Qwen 3.8-27B)</h3>
      <p class="text-slate-400 mb-4">Tested against a local LLM endpoint (<code>RadixArk/Qwen3.8-27B-NVFP4</code> via SGLang) across 6 real-world UI visual regression scenarios:</p>
      <ul class="list-disc pl-5 space-y-1.5 text-slate-300 text-sm">
        <li><strong>Vision Image Tokens:</strong> 5,252 tokens ➔ <strong class="text-emerald-400">644 tokens</strong> (-87.7% ViT Token Reduction)</li>
        <li><strong>Total Prompt + Reasoning Tokens:</strong> 11,556 tokens ➔ <strong class="text-emerald-400">5,421 tokens</strong> (-53.1% Total Tokens Saved)</li>
        <li><strong>Average Latency:</strong> 53.3s ➔ <strong class="text-emerald-400">36.4s</strong> (32% Faster Roundtrips)</li>
        <li><strong>Diagnostic Triage Accuracy:</strong> 76.7% ➔ <strong class="text-emerald-400">82.5%</strong> (+5.8% Accuracy)</li>
      </ul>
      <div class="mt-4">
        <a href="/guides/benchmarks/" class="link link-primary font-semibold inline-flex items-center gap-1.5">
          👉 Read the full Empirical LLM Benchmark Report →
        </a>
      </div>
    </div>
  </section>

  <div class="divider my-12 border-slate-800"></div>

  <section class="my-12">
    <h2 class="text-3xl font-extrabold text-slate-100 tracking-tight mb-6">📐 Model Vision Grid Reference</h2>
    <div class="overflow-x-auto my-6">
      <table class="table w-full rounded-xl overflow-hidden border border-slate-700/60 bg-slate-900/60 backdrop-blur-md">
        <thead>
          <tr class="bg-slate-800/90 text-slate-100 uppercase text-xs tracking-wider">
            <th>Provider Setting</th>
            <th>Target Max Bounding Box</th>
            <th>Vision Grid Mechanics</th>
            <th>Approx. Token Cost per Diff</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>openai</code></td>
            <td><code>512 × 512 px</code></td>
            <td>Fits inside 1 standard OpenAI <code>512px</code> tile</td>
            <td class="text-emerald-400 font-semibold">~85 – 255 tokens</td>
          </tr>
          <tr>
            <td><code>anthropic</code></td>
            <td><code>504 × 504 px</code></td>
            <td>Exact <code>18 × 18</code> grid of <code>28×28 px</code> patches</td>
            <td class="text-emerald-400 font-semibold">~28 – 324 tokens</td>
          </tr>
          <tr>
            <td><code>gemini</code></td>
            <td><code>768 × 768 px</code></td>
            <td>Fits 1 native Gemini tile</td>
            <td class="text-emerald-400 font-semibold">~258 tokens</td>
          </tr>
          <tr>
            <td><code>gemini</code> (<code>lowTokenMode</code>)</td>
            <td><code>384 × 384 px</code></td>
            <td>Sub-384px single base tile optimization</td>
            <td class="text-emerald-400 font-semibold">~258 tokens (ultra-fast)</td>
          </tr>
          <tr>
            <td><code>local</code></td>
            <td><code>448 × 448 px</code> (configurable)</td>
            <td>Optimized for local VLMs (<code>28px</code> / <code>14px</code> patch ViTs)</td>
            <td class="text-slate-300">Local compute</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  </div>
</StarlightPage>
