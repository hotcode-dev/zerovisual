---
// Interactive Visual Regression & AI Session Benchmark Explorer
import benchmarkData from '../data/benchmark-sessions.json';
---

<div class="benchmark-explorer not-content" id="benchmark-explorer-root">
  <!-- Top Banner / Live Status -->
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 bg-[#0f141e] border border-[#1e2736] rounded-xl mb-6">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-semibold tracking-wide uppercase text-slate-200">Empirical VLM Evaluation</span>
      <span class="text-slate-600" aria-hidden="true">|</span>
      <span class="text-xs text-slate-400 font-mono">RadixArk/Qwen3.8-27B-NVFP4</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs px-2.5 py-1 rounded-full bg-slate-800/80 border border-slate-700 text-slate-200 font-medium font-mono">
        11 Scenarios (5 Live)
      </span>
      <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/35 text-emerald-300 font-semibold font-mono tabular-nums">
        Avg -85% ViT Tokens
      </span>
      <a
        href="https://github.com/hotcode-dev/zerovisual/tree/main/benchmark"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 min-h-[36px] text-xs px-3 py-1 rounded-lg bg-[#161d2b] hover:bg-slate-800 border border-[#2d3a4f] hover:border-emerald-500/50 text-slate-200 hover:text-white transition-colors font-medium no-underline cursor-pointer"
        title="View Benchmark Source Code on GitHub"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub /benchmark</span>
        <span class="text-slate-400" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <!-- Filter & Case Selector -->
  <div class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold text-slate-200" id="scenario-filter-label">Select Benchmark Scenario:</span>
        <div class="inline-flex flex-wrap rounded-lg bg-[#090c12] p-1 border border-[#1e2736] text-xs gap-1" role="group" aria-labelledby="scenario-filter-label">
          <button type="button" class="filter-btn active" aria-pressed="true" data-filter="all">
            All (11)
          </button>
          <button type="button" class="filter-btn" aria-pressed="false" data-filter="real">
            Live Websites (5)
          </button>
          <button type="button" class="filter-btn" aria-pressed="false" data-filter="synthetic">
            Synthetic (6)
          </button>
        </div>
      </div>
    </div>

    <!-- Case Picker Cards Grid: Max 4 a row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5" id="case-picker-grid">
      {benchmarkData.map((item, index) => {
        const isReal = item.id.includes('real');
        return (
          <button
            type="button"
            class={`case-card text-left p-3 rounded-lg border cursor-pointer bg-[#0f141e] border-[#1e2736] hover:bg-[#161d2b] hover:border-[#2d3a4f] ${
              index === 0 ? 'active' : ''
            }`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-case-id={item.id}
            data-case-index={index}
            data-is-real={isReal ? 'true' : 'false'}
          >
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-[#090c12] text-slate-400 border border-[#1e2736] tabular-nums">
                #{String(index + 1).padStart(2, '0')}
              </span>
              <span class={`text-[11px] font-semibold px-1.5 py-0.5 rounded font-mono ${
                isReal ? 'bg-cyan-500/10 text-cyan-300 border border-cyan-500/25' : 'bg-slate-800/80 text-slate-300 border border-slate-700/60'
              }`}>
                {isReal ? 'Live' : 'Synthetic'}
              </span>
            </div>
            <div class="text-xs font-semibold text-slate-100 line-clamp-1 mb-1.5" title={item.name}>
              {item.name}
            </div>
            <div class="flex items-center justify-between text-[11px] text-slate-400 font-mono tabular-nums">
              <span>{item.device.includes('Mobile') ? 'Mobile' : 'Desktop'}</span>
              <span class="font-bold text-emerald-400">-{item.savings.imageTokens}</span>
            </div>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Active Case Showcase Main Stage -->
  <div class="bg-[#0f141e] border border-[#1e2736] rounded-2xl p-4 sm:p-6 mb-8">
    
    <!-- Active Case Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-[#1e2736] mb-6">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span id="active-device-badge" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#161d2b] text-slate-200 border border-[#2d3a4f]">
            Desktop (1280×800)
          </span>
          <span id="active-category-badge" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
            Layout Shift
          </span>
          <span class="text-xs text-slate-400 font-mono" id="active-case-id">
            01-wikipedia-search-offset
          </span>
          <a
            id="active-case-github-link"
            href="https://github.com/hotcode-dev/zerovisual/tree/main/benchmark/testdata/01-wikipedia-search-offset"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-emerald-400 hover:text-emerald-300 inline-flex items-center gap-1 font-mono transition-colors no-underline"
          >
            <span>testdata/01 ↗</span>
          </a>
        </div>
        <h3 id="active-case-name" class="text-xl sm:text-2xl font-bold text-slate-50 tracking-tight m-0">
          Wikipedia Portal Search Bar Shift
        </h3>
        <p id="active-ground-truth-defect" class="text-sm text-slate-400 mt-1 max-w-3xl m-0">
          The search box container is shifted right by 60px with red border override.
        </p>
      </div>

      <!-- Quick Savings Pill -->
      <div class="flex items-center gap-4 bg-[#090c12] border border-[#1e2736] px-4 py-2.5 rounded-xl self-start md:self-auto">
        <div class="text-right">
          <div class="text-[11px] uppercase font-bold tracking-wider text-slate-400 font-mono">ViT Savings</div>
          <div class="text-lg font-extrabold text-emerald-400 tabular-nums" id="active-token-savings">-80.8%</div>
        </div>
        <div class="h-8 w-px bg-[#1e2736]" aria-hidden="true"></div>
        <div class="text-right">
          <div class="text-[11px] uppercase font-bold tracking-wider text-slate-400 font-mono">Payload</div>
          <div class="text-lg font-extrabold text-cyan-400 tabular-nums" id="active-byte-savings">-75.6%</div>
        </div>
      </div>
    </div>

    <!-- Vertical Stacked Sections -->
    <div class="flex flex-col gap-8">
      
      <!-- TOP SECTION: Interactive Screenshot Visualizer -->
      <div class="w-full flex flex-col">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2 px-1">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-200 flex flex-wrap items-center gap-2">
            <span>Visual Regression Triage Stage</span>
            <span class="text-xs font-normal text-slate-400">(Compare Baselines, Defects, Diffs &amp; Crops)</span>
          </span>
          <span class="text-xs text-slate-400 font-mono tabular-nums" id="current-viewport-dims">1280 × 800</span>
        </div>

        <!-- Browser Chrome Toolbar -->
        <div class="bg-[#161d2b] border border-[#1e2736] rounded-t-xl px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-400/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80 inline-block"></span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1 bg-[#090c12] border border-[#1e2736] rounded-md text-xs text-slate-300 font-mono flex-1 min-w-[180px] max-w-md truncate">
            <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
            <span id="browser-url-text" class="truncate">https://www.wikipedia.org/</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-rose-300 bg-rose-500/15 px-2.5 py-1 rounded border border-rose-500/30 font-mono font-semibold">
            <span class="w-2 h-2 rounded-full bg-rose-400" aria-hidden="true"></span>
            <span>PLAYWRIGHT FAILED</span>
          </div>
        </div>

        <!-- View Mode Switcher -->
        <div class="bg-[#090c12] border-x border-[#1e2736] px-3.5 py-2.5 flex flex-wrap items-center justify-between gap-3 border-b">
          <div class="inline-flex flex-wrap rounded-lg bg-[#0f141e] p-1 border border-[#1e2736] text-xs gap-1" role="tablist" aria-label="Screenshot view mode">
            <button type="button" role="tab" aria-selected="false" class="img-view-tab" data-view="baseline">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block" aria-hidden="true"></span>
                <span>Baseline</span>
              </span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="img-view-tab" data-view="actual">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rose-400 inline-block" aria-hidden="true"></span>
                <span>Actual (Defect)</span>
              </span>
            </button>
            <button type="button" role="tab" aria-selected="false" class="img-view-tab" data-view="diff">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-400 inline-block" aria-hidden="true"></span>
                <span>Pixel Diff</span>
              </span>
            </button>
            <button type="button" role="tab" aria-selected="true" class="img-view-tab active" data-view="crop">
              <span class="inline-flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-cyan-400 inline-block" aria-hidden="true"></span>
                <span>ZeroVisual Crop (VLM)</span>
              </span>
            </button>
          </div>

          <!-- Bounding Box Overlay Toggle -->
          <button type="button" id="toggle-bbox-btn" class="toggle-bbox-btn" aria-pressed="false" title="Toggle bounding box highlight">
            <span class="w-2.5 h-2.5 rounded-sm bg-rose-500 inline-block" aria-hidden="true"></span>
            <span id="bbox-toggle-text">Show Diff Bounding Box</span>
          </button>
        </div>

        <!-- Image Display Stage Frame -->
        <div class="relative bg-[#06080d] border-x border-b border-[#1e2736] rounded-b-xl overflow-hidden min-h-[360px] sm:min-h-[440px] flex items-center justify-center p-4 pb-14 select-none">
          <div class="relative max-w-full max-h-[480px] flex items-center justify-center" id="image-container">
            <img
              id="main-stage-img"
              src={benchmarkData[0].cropPath}
              alt="Benchmark screenshot view"
              class="max-w-full max-h-[440px] w-auto h-auto rounded-lg object-contain transition-opacity duration-200 shadow-lg"
              loading="eager"
            />
            
            <!-- Dynamic Diff Bounding Box Overlay -->
            <div
              id="bbox-overlay"
              class="absolute border-2 border-rose-500 bg-rose-500/15 pointer-events-none transition-all duration-200 hidden rounded-sm"
              style="left: 0%; top: 0%; width: 0%; height: 0%;"
            >
              <span class="absolute -top-6 left-0 text-[11px] font-mono font-bold bg-rose-600 text-white px-2 py-0.5 rounded shadow whitespace-nowrap" id="bbox-coord-chip">
                Diff Box
              </span>
            </div>
          </div>

          <!-- Stage View Floating Badge -->
          <div class="absolute bottom-3 left-3 right-3 sm:right-auto px-3 py-1.5 rounded-md bg-[#0f141e]/95 border border-[#2d3a4f] text-xs text-slate-300 flex flex-wrap items-center gap-2">
            <span class="font-semibold text-white" id="stage-view-label">ZeroVisual ViT Crop (WebP)</span>
            <span class="text-slate-600" aria-hidden="true">|</span>
            <span class="font-mono text-slate-300 tabular-nums" id="stage-view-dims">504 × 389 px</span>
            <span class="text-slate-600" aria-hidden="true">|</span>
            <span class="font-mono text-emerald-400 font-semibold tabular-nums" id="stage-view-bytes">6.0 KB</span>
          </div>
        </div>

        <!-- Token Comparison Metrics Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
          <div class="bg-[#090c12] border border-[#1e2736] rounded-xl p-3.5">
            <div class="text-[11px] uppercase font-bold text-slate-400 font-mono mb-1">ViT Image Tokens</div>
            <div class="flex items-baseline gap-2 tabular-nums">
              <span class="text-lg font-extrabold text-emerald-400" id="metric-opt-img-tokens">192</span>
              <span class="text-xs text-slate-500 line-through" id="metric-raw-img-tokens">1,000</span>
            </div>
            <div class="text-xs text-emerald-300 font-medium mt-1 tabular-nums" id="metric-img-token-saved">-80.8% ViT Tokens</div>
          </div>

          <div class="bg-[#090c12] border border-[#1e2736] rounded-xl p-3.5">
            <div class="text-[11px] uppercase font-bold text-slate-400 font-mono mb-1">Payload Transfer</div>
            <div class="flex items-baseline gap-2 tabular-nums">
              <span class="text-lg font-extrabold text-cyan-400" id="metric-opt-bytes">6.1 KB</span>
              <span class="text-xs text-slate-500 line-through" id="metric-raw-bytes">25.2 KB</span>
            </div>
            <div class="text-xs text-cyan-300 font-medium mt-1 tabular-nums" id="metric-bytes-saved">-75.6% Bandwidth</div>
          </div>

          <div class="bg-[#090c12] border border-[#1e2736] rounded-xl p-3.5">
            <div class="text-[11px] uppercase font-bold text-slate-400 font-mono mb-1">Total Tokens</div>
            <div class="flex items-baseline gap-2 tabular-nums">
              <span class="text-lg font-extrabold text-slate-100" id="metric-opt-total-tokens">2,378</span>
              <span class="text-xs text-slate-500 line-through" id="metric-raw-total-tokens">3,186</span>
            </div>
            <div class="text-xs text-slate-300 font-medium mt-1 tabular-nums" id="metric-total-token-saved">-25.4% Tokens</div>
          </div>

          <div class="bg-[#090c12] border border-[#1e2736] rounded-xl p-3.5">
            <div class="text-[11px] uppercase font-bold text-slate-400 font-mono mb-1">Inference Latency</div>
            <div class="flex items-baseline gap-2 tabular-nums">
              <span class="text-lg font-extrabold text-slate-100" id="metric-opt-latency">96.8s</span>
              <span class="text-xs text-slate-500 line-through" id="metric-raw-latency">103.4s</span>
            </div>
            <div class="text-xs text-slate-400 font-medium mt-1 tabular-nums" id="metric-latency-saved">6% Faster</div>
          </div>
        </div>
      </div>

      <!-- BOTTOM SECTION: AI Session & Reasoning Inspector -->
      <div class="w-full flex flex-col pt-4 border-t border-[#1e2736]">
        <!-- Inspector Top Navigation Bar -->
        <div class="bg-[#161d2b] border border-[#1e2736] rounded-t-xl px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider inline-flex items-center gap-1.5 font-mono">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span>AI Session Trace &amp; VLM Diagnosis</span>
            </span>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#090c12] text-slate-200 border border-[#2d3a4f] font-semibold" id="session-model-chip">
              Qwen3.8-27B
            </span>
          </div>

          <!-- Mode Switcher: With vs Without ZeroVisual -->
          <div class="inline-flex flex-wrap rounded-lg bg-[#090c12] p-1 border border-[#1e2736] text-xs gap-1" role="tablist" aria-label="Session comparison mode">
            <button type="button" role="tab" aria-selected="true" id="session-mode-opt" class="session-mode-btn active" data-mode="with">
              With ZeroVisual (Cropped ViT)
            </button>
            <button type="button" role="tab" aria-selected="false" id="session-mode-raw" class="session-mode-btn" data-mode="without">
              Without (Raw Viewport)
            </button>
          </div>
        </div>

        <!-- Session Content Body Frame -->
        <div class="bg-[#090c12] border-x border-b border-[#1e2736] rounded-b-xl p-4 sm:p-5 flex flex-col gap-5 overflow-hidden">
          
          <!-- Accuracy Score & Triage Status Card -->
          <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-[#0f141e] border border-[#1e2736]">
            <div>
              <div class="text-[11px] uppercase font-bold text-slate-400 font-mono mb-0.5">Triage Accuracy Score</div>
              <div class="text-xl font-bold text-white flex flex-wrap items-center gap-2.5 tabular-nums">
                <span id="session-accuracy-score">65%</span>
                <span class="text-xs font-medium text-emerald-300 px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/35" id="session-match-status">
                  ✓ Defect Correctly Identified
                </span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-5 text-xs text-slate-400">
              <div>
                <div class="text-[11px] uppercase font-bold text-slate-500 font-mono">Reasoning</div>
                <span class="font-mono text-slate-200 font-semibold tabular-nums" id="session-reasoning-tokens">1,815</span> tok
              </div>
              <div>
                <div class="text-[11px] uppercase font-bold text-slate-500 font-mono">Completion</div>
                <span class="font-mono text-slate-200 font-semibold tabular-nums" id="session-completion-tokens">2,048</span> tok
              </div>
              <div>
                <div class="text-[11px] uppercase font-bold text-slate-500 font-mono">Session ID</div>
                <span class="font-mono text-slate-300 text-xs" id="session-id-display">session-01-wikipedia</span>
              </div>
            </div>
          </div>

          <!-- AI Model Diagnosis Response -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-200">Model Triage Diagnosis (Final Answer)</span>
              <span class="text-xs text-slate-400 font-mono">Structured Output</span>
            </div>
            <div
              id="model-diagnosis-text"
              class="p-4 rounded-xl bg-[#0f141e] border border-[#1e2736] text-xs sm:text-sm text-slate-200 font-mono leading-relaxed max-h-[220px] overflow-y-auto whitespace-pre-wrap select-text"
            >
              1. Affected Element: .search-box
              2. Defect: Red outline wrapping search box and button
              3. Root Cause: border: 2px solid #cc0000 on wrapper
              4. Fix: Scope border to input only
            </div>
          </div>

          <!-- Collapsible Reasoning Trace (<think>) -->
          <div class="flex flex-col">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <button
                type="button"
                id="toggle-reasoning-btn"
                aria-expanded="true"
                aria-controls="reasoning-trace-box"
                class="inline-flex items-center gap-2 min-h-[44px] px-3 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-emerald-300 hover:text-white bg-[#0f141e] hover:bg-[#161d2b] border border-[#2d3a4f] hover:border-emerald-500/50 transition-colors cursor-pointer"
              >
                <svg id="reasoning-arrow" class="w-4 h-4 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
                <span>VLM Chain-of-Thought Reasoning (&lt;think&gt;)</span>
              </button>
              <span class="text-xs text-slate-400 font-mono tabular-nums" id="think-token-count">1,815 tokens</span>
            </div>

            <div
              id="reasoning-trace-box"
              class="p-4 rounded-xl bg-[#06080d] border border-[#1e2736] text-xs font-mono text-slate-300 leading-relaxed overflow-y-auto max-h-[240px] select-text"
            >
              <div id="model-reasoning-text" class="whitespace-pre-wrap">
                Thinking trace loading...
              </div>
            </div>
          </div>

          <!-- Ground Truth Reference Box -->
          <div class="p-4 rounded-xl bg-[#0f141e] border border-[#1e2736] text-xs">
            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono mb-1.5">
              Ground Truth Defect &amp; Suggested Fix
            </div>
            <div class="text-slate-200 text-xs sm:text-sm leading-relaxed mb-2.5" id="ground-truth-desc">
              The .search-box container is shifted right by 60px with red border.
            </div>
            <div class="font-mono text-xs text-emerald-300 bg-[#06080d] p-3 rounded-lg border border-[#1e2736]" id="ground-truth-fix">
              Fix: Remove margin-left: 60px, restore input padding to 12px 16px, restore button color to #36c
            </div>
          </div>

          <!-- Footer GitHub Benchmark Repo Link Banner -->
          <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl bg-[#0f141e] border border-[#1e2736] text-xs text-slate-300">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-emerald-400 font-semibold font-mono">Reproduce locally:</span>
              <span>All 11 datasets, Playwright test specs, and VLM runner are open-source.</span>
            </div>
            <a
              href="https://github.com/hotcode-dev/zerovisual/tree/main/benchmark"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-[44px] text-xs px-4 py-3 rounded-lg bg-[#10b981] hover:bg-[#34d399] text-[#03150e] font-bold transition-colors border border-emerald-300 no-underline whitespace-nowrap cursor-pointer"
            >
              <span>Explore /benchmark on GitHub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .benchmark-explorer {
    margin: 2rem 0;
    font-family: inherit;
  }

  /* Scenario Picker Cards */
  .case-card {
    min-height: 84px;
    transition: background-color 160ms var(--zv-ease-out), border-color 160ms var(--zv-ease-out), transform 160ms var(--zv-ease-out);
  }

  .case-card:hover:not(.active) {
    transform: translateY(-1px);
  }

  .case-card:active {
    transform: scale(0.985);
  }

  .case-card.active {
    border-color: rgba(16, 185, 129, 0.7) !important;
    background: rgba(16, 185, 129, 0.1) !important;
    box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.25);
  }

  /* Shared button base — 44px touch targets */
  .filter-btn, .img-view-tab, .session-mode-btn {
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #cbd5e1;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 150ms var(--zv-ease-out), color 150ms var(--zv-ease-out), border-color 150ms var(--zv-ease-out);
  }

  .filter-btn:hover:not(.active), .session-mode-btn:hover:not(.active) {
    color: #ffffff;
    background: #161d2b;
  }

  /* Scenario Filter Buttons — 44px touch targets */
  .filter-btn.active {
    background: #161d2b;
    color: #a7f3d0;
    font-weight: 600;
    border-color: rgba(16, 185, 129, 0.45);
  }

  /* Image View Tabs — 44px touch targets */
  .img-view-tab {
    display: inline-flex;
    align-items: center;
  }

  .img-view-tab:hover:not(.active) {
    color: #ffffff;
    background: #161d2b;
  }

  .img-view-tab[data-view="baseline"].active {
    background: rgba(16, 185, 129, 0.18);
    color: #a7f3d0;
    font-weight: 600;
    border-color: rgba(16, 185, 129, 0.55);
  }

  .img-view-tab[data-view="actual"].active {
    background: rgba(225, 29, 72, 0.22);
    color: #fecdd3;
    font-weight: 600;
    border-color: rgba(251, 113, 133, 0.55);
  }

  .img-view-tab[data-view="diff"].active {
    background: rgba(245, 158, 11, 0.18);
    color: #fde68a;
    font-weight: 600;
    border-color: rgba(251, 191, 36, 0.55);
  }

  .img-view-tab[data-view="crop"].active {
    background: rgba(6, 182, 212, 0.18);
    color: #a5f3fc;
    font-weight: 600;
    border-color: rgba(34, 211, 238, 0.55);
  }

  /* Diff Bounding Box Toggle Button — 44px touch target */
  #toggle-bbox-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 0.875rem;
    border-radius: 8px;
    background: #0f141e;
    color: #cbd5e1;
    border: 1px solid #2d3a4f;
    cursor: pointer;
    transition: background-color 150ms var(--zv-ease-out), color 150ms var(--zv-ease-out), border-color 150ms var(--zv-ease-out);
  }

  #toggle-bbox-btn:hover {
    background: #161d2b;
    color: #ffffff;
    border-color: #475569;
  }

  #toggle-bbox-btn.active {
    background: rgba(225, 29, 72, 0.2);
    border-color: rgba(251, 113, 133, 0.65);
    color: #fecdd3;
  }

  /* Session Mode Buttons — 44px touch targets */
  .session-mode-btn[data-mode="with"].active {
    background: rgba(16, 185, 129, 0.16);
    color: #a7f3d0;
    font-weight: 600;
    border-color: rgba(16, 185, 129, 0.5);
  }

  .session-mode-btn[data-mode="without"].active {
    background: #1e293b;
    color: #f8fafc;
    font-weight: 600;
    border-color: #475569;
  }

  /* Custom scrollbars for trace boxes */
  #model-diagnosis-text::-webkit-scrollbar,
  #reasoning-trace-box::-webkit-scrollbar {
    width: 6px;
  }

  #model-diagnosis-text::-webkit-scrollbar-track,
  #reasoning-trace-box::-webkit-scrollbar-track {
    background: #090c12;
  }

  #model-diagnosis-text::-webkit-scrollbar-thumb,
  #reasoning-trace-box::-webkit-scrollbar-thumb {
    background: #2d3a4f;
    border-radius: 3px;
  }

  #model-diagnosis-text::-webkit-scrollbar-thumb:hover,
  #reasoning-trace-box::-webkit-scrollbar-thumb:hover {
    background: #10b981;
  }
</style>

<script define:vars={{ benchmarkData }}>
  import { setGroupActive } from '../lib/toggle-group.ts';

  (function () {
    let currentCaseIndex = 0;
    let currentViewMode = 'crop';
    let currentSessionMode = 'with';
    let showBoundingBox = false;

    const caseCards = document.querySelectorAll('.case-card');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const imgViewTabs = document.querySelectorAll('.img-view-tab');
    const sessionModeBtns = document.querySelectorAll('.session-mode-btn');
    const toggleBboxBtn = document.getElementById('toggle-bbox-btn');
    const bboxToggleText = document.getElementById('bbox-toggle-text');
    const toggleReasoningBtn = document.getElementById('toggle-reasoning-btn');
    const reasoningArrow = document.getElementById('reasoning-arrow');
    const reasoningTraceBox = document.getElementById('reasoning-trace-box');

    const activeDeviceBadge = document.getElementById('active-device-badge');
    const activeCategoryBadge = document.getElementById('active-category-badge');
    const activeCaseId = document.getElementById('active-case-id');
    const activeCaseGithubLink = document.getElementById('active-case-github-link');
    const activeCaseName = document.getElementById('active-case-name');
    const activeGroundTruthDefect = document.getElementById('active-ground-truth-defect');
    const activeTokenSavings = document.getElementById('active-token-savings');
    const activeByteSavings = document.getElementById('active-byte-savings');
    const browserUrlText = document.getElementById('browser-url-text');
    const currentViewportDims = document.getElementById('current-viewport-dims');

    const mainStageImg = document.getElementById('main-stage-img');
    const bboxOverlay = document.getElementById('bbox-overlay');
    const bboxCoordChip = document.getElementById('bbox-coord-chip');
    const stageViewLabel = document.getElementById('stage-view-label');
    const stageViewDims = document.getElementById('stage-view-dims');
    const stageViewBytes = document.getElementById('stage-view-bytes');

    const metricOptImgTokens = document.getElementById('metric-opt-img-tokens');
    const metricRawImgTokens = document.getElementById('metric-raw-img-tokens');
    const metricImgTokenSaved = document.getElementById('metric-img-token-saved');
    const metricOptBytes = document.getElementById('metric-opt-bytes');
    const metricRawBytes = document.getElementById('metric-raw-bytes');
    const metricBytesSaved = document.getElementById('metric-bytes-saved');
    const metricOptTotalTokens = document.getElementById('metric-opt-total-tokens');
    const metricRawTotalTokens = document.getElementById('metric-raw-total-tokens');
    const metricTotalTokenSaved = document.getElementById('metric-total-token-saved');
    const metricOptLatency = document.getElementById('metric-opt-latency');
    const metricRawLatency = document.getElementById('metric-raw-latency');
    const metricLatencySaved = document.getElementById('metric-latency-saved');

    const sessionAccuracyScore = document.getElementById('session-accuracy-score');
    const sessionMatchStatus = document.getElementById('session-match-status');
    const sessionReasoningTokens = document.getElementById('session-reasoning-tokens');
    const sessionCompletionTokens = document.getElementById('session-completion-tokens');
    const sessionIdDisplay = document.getElementById('session-id-display');
    const modelDiagnosisText = document.getElementById('model-diagnosis-text');
    const modelReasoningText = document.getElementById('model-reasoning-text');
    const thinkTokenCount = document.getElementById('think-token-count');
    const groundTruthDesc = document.getElementById('ground-truth-desc');
    const groundTruthFix = document.getElementById('ground-truth-fix');

    function getDomainForCase(item) {
      if (item.id.includes('wikipedia')) return 'https://www.wikipedia.org/';
      if (item.id.includes('hackernews')) return 'https://news.ycombinator.com/';
      if (item.id.includes('github-pricing')) return 'https://github.com/pricing';
      if (item.id.includes('github-pr')) return 'https://github.com/hotcode-dev/zerovisual/pull/42';
      if (item.id.includes('mdn')) return 'https://developer.mozilla.org/en-US/';
      if (item.id.includes('saas')) return 'https://cloud-saas.example.com/pricing';
      if (item.id.includes('ecommerce')) return 'https://store.example.com/cart';
      if (item.id.includes('dashboard')) return 'https://analytics.internal/dashboard';
      return 'https://app.example.com/';
    }

    function renderActiveCase() {
      const item = benchmarkData[currentCaseIndex];
      if (!item) return;

      if (activeDeviceBadge) activeDeviceBadge.textContent = `${item.device} (${item.viewport.width}×${item.viewport.height})`;
      if (activeCategoryBadge) activeCategoryBadge.textContent = item.category;
      if (activeCaseId) activeCaseId.textContent = item.id;
      if (activeCaseGithubLink) {
        activeCaseGithubLink.href = `https://github.com/hotcode-dev/zerovisual/tree/main/benchmark/testdata/${item.id}`;
        activeCaseGithubLink.textContent = `testdata/${item.id} ↗`;
      }
      if (activeCaseName) activeCaseName.textContent = item.name;
      if (activeGroundTruthDefect) activeGroundTruthDefect.textContent = item.groundTruth.defect;
      if (activeTokenSavings) activeTokenSavings.textContent = `-${item.savings.imageTokens}`;
      if (activeByteSavings) activeByteSavings.textContent = `-${item.savings.bytes}`;
      if (browserUrlText) browserUrlText.textContent = getDomainForCase(item);
      if (currentViewportDims) currentViewportDims.textContent = `${item.viewport.width} × ${item.viewport.height} px`;

      if (metricOptImgTokens) metricOptImgTokens.textContent = item.with.imageTokens.toLocaleString();
      if (metricRawImgTokens) metricRawImgTokens.textContent = item.without.imageTokens.toLocaleString();
      if (metricImgTokenSaved) metricImgTokenSaved.textContent = `-${item.savings.imageTokens} ViT Tokens`;

      if (metricOptBytes) metricOptBytes.textContent = `${(item.with.imagePayloadBytes / 1024).toFixed(1)} KB`;
      if (metricRawBytes) metricRawBytes.textContent = `${(item.without.imagePayloadBytes / 1024).toFixed(1)} KB`;
      if (metricBytesSaved) metricBytesSaved.textContent = `-${item.savings.bytes} Transfer`;

      if (metricOptTotalTokens) metricOptTotalTokens.textContent = item.with.totalTokens.toLocaleString();
      if (metricRawTotalTokens) metricRawTotalTokens.textContent = item.without.totalTokens.toLocaleString();
      if (metricTotalTokenSaved) metricTotalTokenSaved.textContent = `-${item.savings.totalTokens} Tokens`;

      if (metricOptLatency) metricOptLatency.textContent = `${(item.with.latencyMs / 1000).toFixed(1)}s`;
      if (metricRawLatency) metricRawLatency.textContent = `${(item.without.latencyMs / 1000).toFixed(1)}s`;
      if (metricLatencySaved) metricLatencySaved.textContent = item.savings.latency;

      if (groundTruthDesc) groundTruthDesc.textContent = item.groundTruth.defect;
      if (groundTruthFix) groundTruthFix.textContent = `Expected: ${item.groundTruth.suggestedFix}`;

      renderImageStage(item);
      renderSessionInspector(item);

      caseCards.forEach((card, idx) => {
        const isActive = idx === currentCaseIndex;
        card.classList.toggle('active', isActive);
        card.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function renderImageStage(item) {
      if (!mainStageImg) return;

      let src = item.cropPath;
      let label = 'ZeroVisual ViT Crop (WebP)';
      let dims = `${item.with.imageResolution.width} × ${item.with.imageResolution.height} px`;
      let bytes = `${(item.with.imagePayloadBytes / 1024).toFixed(1)} KB`;

      if (currentViewMode === 'baseline') {
        src = item.baselinePath;
        label = 'Pristine Baseline (Pre-Bug)';
        dims = `${item.viewport.width} × ${item.viewport.height} px`;
        bytes = `${(item.without.imagePayloadBytes / 1024).toFixed(1)} KB`;
      } else if (currentViewMode === 'actual') {
        src = item.actualPath;
        label = 'Actual Viewport (Injected Regression)';
        dims = `${item.viewport.width} × ${item.viewport.height} px`;
        bytes = `${(item.without.imagePayloadBytes / 1024).toFixed(1)} KB`;
      } else if (currentViewMode === 'diff') {
        src = item.diffPath;
        label = 'Pixel Diff Overlay';
        dims = `${item.viewport.width} × ${item.viewport.height} px`;
        bytes = 'Diff Mask';
      }

      mainStageImg.src = src;
      if (stageViewLabel) stageViewLabel.textContent = label;
      if (stageViewDims) stageViewDims.textContent = dims;
      if (stageViewBytes) stageViewBytes.textContent = bytes;

      if (bboxOverlay && bboxCoordChip) {
        if (showBoundingBox && currentViewMode !== 'crop') {
          bboxOverlay.classList.remove('hidden');
          const box = item.cropBox;
          const leftPct = (box.x / item.viewport.width) * 100;
          const topPct = (box.y / item.viewport.height) * 100;
          const widthPct = (box.width / item.viewport.width) * 100;
          const heightPct = (box.height / item.viewport.height) * 100;

          bboxOverlay.style.left = `${leftPct}%`;
          bboxOverlay.style.top = `${topPct}%`;
          bboxOverlay.style.width = `${widthPct}%`;
          bboxOverlay.style.height = `${heightPct}%`;
          bboxCoordChip.textContent = `Crop Box: ${box.x},${box.y} (${box.width}×${box.height})`;
        } else {
          bboxOverlay.classList.add('hidden');
        }
      }
    }

    function renderSessionInspector(item) {
      const session = currentSessionMode === 'with' ? item.with : item.without;
      if (!session) return;

      if (sessionAccuracyScore) sessionAccuracyScore.textContent = `${session.accuracyScore}%`;
      if (sessionMatchStatus) {
        if (session.accuracyScore >= 65) {
          sessionMatchStatus.textContent = '✓ Defect Correctly Identified';
          sessionMatchStatus.className = 'text-xs font-medium text-emerald-300 px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/35';
        } else {
          sessionMatchStatus.textContent = '⚠ Partial / Missed Defect';
          sessionMatchStatus.className = 'text-xs font-medium text-amber-300 px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/35';
        }
      }

      if (sessionReasoningTokens) sessionReasoningTokens.textContent = session.reasoningTokens.toLocaleString();
      if (sessionCompletionTokens) sessionCompletionTokens.textContent = session.completionTokens.toLocaleString();
      if (thinkTokenCount) thinkTokenCount.textContent = `${session.reasoningTokens.toLocaleString()} tokens`;
      if (sessionIdDisplay) sessionIdDisplay.textContent = session.sessionId ? session.sessionId.slice(0, 24) + '...' : 'simulated';

      if (modelDiagnosisText) {
        modelDiagnosisText.textContent = session.modelAnswer || 'No structured model answer recorded.';
      }

      if (modelReasoningText) {
        modelReasoningText.textContent = session.modelReasoning || 'Reasoning trace not recorded.';
      }
    }

    caseCards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-case-index') || '0', 10);
        currentCaseIndex = idx;
        renderActiveCase();
      });
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setGroupActive(filterBtns, btn, 'aria-pressed');

        const filter = btn.getAttribute('data-filter');
        caseCards.forEach((card) => {
          const isReal = card.getAttribute('data-is-real') === 'true';
          if (filter === 'all') {
            card.style.display = '';
          } else if (filter === 'real') {
            card.style.display = isReal ? '' : 'none';
          } else if (filter === 'synthetic') {
            card.style.display = !isReal ? '' : 'none';
          }
        });
      });
    });

    imgViewTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        setGroupActive(imgViewTabs, tab, 'aria-selected');

        currentViewMode = tab.getAttribute('data-view') || 'crop';
        renderActiveCase();
      });
    });

    sessionModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setGroupActive(sessionModeBtns, btn, 'aria-selected');

        currentSessionMode = btn.getAttribute('data-mode') || 'with';
        const item = benchmarkData[currentCaseIndex];
        renderSessionInspector(item);
      });
    });

    if (toggleBboxBtn) {
      toggleBboxBtn.addEventListener('click', () => {
        showBoundingBox = !showBoundingBox;
        if (bboxToggleText) {
          bboxToggleText.textContent = showBoundingBox ? 'Hide Diff Bounding Box' : 'Show Diff Bounding Box';
        }
        toggleBboxBtn.classList.toggle('active', showBoundingBox);
        toggleBboxBtn.setAttribute('aria-pressed', showBoundingBox ? 'true' : 'false');
        renderActiveCase();
      });
    }

    let reasoningExpanded = true;
    if (toggleReasoningBtn && reasoningTraceBox && reasoningArrow) {
      toggleReasoningBtn.addEventListener('click', () => {
        reasoningExpanded = !reasoningExpanded;
        reasoningTraceBox.style.display = reasoningExpanded ? 'block' : 'none';
        reasoningArrow.style.transform = reasoningExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        toggleReasoningBtn.setAttribute('aria-expanded', reasoningExpanded ? 'true' : 'false');
      });
    }

    renderActiveCase();
  })();
</script>
