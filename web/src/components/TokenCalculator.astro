---
// Interactive Token & Byte Savings Calculator for ZeroVisual
---

<div class="token-calc-container">
  <div class="calc-header">
    <div class="calc-title-row">
      <h2 id="calculator-heading">Interactive Token &amp; Byte Savings Calculator</h2>
      <span class="badge-new">9 Vision Providers · Drag &amp; Drop</span>
    </div>
    <p>Estimate Vision LLM token spend and network payload savings for your visual test failures or drop in a real screenshot.</p>
  </div>

  <div class="calc-grid">
    <div class="calc-controls">
      <div class="control-group">
        <label for="provider-select">Target Vision Model Provider</label>
        <select id="provider-select" class="calc-select">
          <option value="anthropic" selected>Anthropic Claude 3.5 / 3.7 Sonnet (504×504 max tile)</option>
          <option value="openai">OpenAI GPT-4o / GPT-4o-mini (512×512 tile grid)</option>
          <option value="gemma">Google Gemma 4 / Gemini 2.0 (768×768 tile)</option>
          <option value="gemma-low">Google Gemma / Gemini Low-Token Mode (384×384 tile)</option>
          <option value="qwen">Qwen 2.5 / 3.8-VL (504×504 patch grid)</option>
          <option value="llama">Meta Llama 3.2 Vision (560×560 tile grid)</option>
          <option value="mistral">Mistral Pixtral (16×16 patch grid)</option>
          <option value="deepseek">DeepSeek-VL (384×384 tile grid)</option>
          <option value="local">Local VLM (448×448 grid)</option>
        </select>
      </div>

      <div class="control-group">
        <span class="control-label" id="preset-group-label">Diff Size Scenario Preset</span>
        <div class="scenario-buttons" role="group" aria-labelledby="preset-group-label">
          <button type="button" class="scenario-btn active" aria-pressed="true" data-w="120" data-h="48" data-raw-w="1920" data-raw-h="1080">Button Shift (120×48)</button>
          <button type="button" class="scenario-btn" aria-pressed="false" data-w="380" data-h="140" data-raw-w="390" data-raw-h="844">Mobile Card (380×140)</button>
          <button type="button" class="scenario-btn" aria-pressed="false" data-w="640" data-h="420" data-raw-w="1920" data-raw-h="1080">Modal Dialog (640×420)</button>
          <button type="button" class="scenario-btn" aria-pressed="false" data-w="1600" data-h="800" data-raw-w="1920" data-raw-h="1080">Full Page Layout (1600×800)</button>
        </div>
      </div>

      <div class="control-group upload-group">
        <label for="image-upload-input">Or Upload / Drop Your Own Screenshot</label>
        <div
          class="drop-zone"
          id="drop-zone"
          role="button"
          tabindex="0"
          aria-describedby="upload-status-text"
        >
          <input type="file" id="image-upload-input" accept="image/*" class="sr-only" />
          <div class="drop-zone-content">
            <svg class="drop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span id="upload-status-text">Drop a PNG/JPG screenshot or click to browse</span>
          </div>
        </div>
      </div>

      <div class="custom-dims-row">
        <div class="control-group">
          <label for="diff-width">Diff Width: <span id="diff-w-val" class="tabular-nums font-mono text-slate-100">120</span>px</label>
          <input type="range" id="diff-width" min="40" max="1920" value="120" step="10" class="calc-slider" />
        </div>
        <div class="control-group">
          <label for="diff-height">Diff Height: <span id="diff-h-val" class="tabular-nums font-mono text-slate-100">48</span>px</label>
          <input type="range" id="diff-height" min="20" max="1080" value="48" step="10" class="calc-slider" />
        </div>
      </div>
    </div>

    <div class="calc-results" aria-live="polite">
      <div class="metric-card savings-highlight">
        <div class="metric-label">Vision Token Reduction</div>
        <div class="metric-value tabular-nums" id="token-savings-pct">98.9%</div>
        <div class="metric-sub tabular-nums" id="token-comparison">2,691 tokens → 28 tokens</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Network / IPC Payload Size</div>
        <div class="metric-value tabular-nums" id="byte-savings-pct">99.8%</div>
        <div class="metric-sub tabular-nums" id="byte-comparison">4,200 KB → ~9 KB WebP</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Model Context Clarity</div>
        <div class="metric-value" id="clarity-status">100% Focused</div>
        <div class="metric-sub tabular-nums" id="dim-comparison">Raw 1920×1080 → Optimized 184×112 (no enlargement)</div>
      </div>
    </div>
  </div>
</div>

<style>
  .token-calc-container {
    background: var(--zv-surface, #0f141e);
    border: 1px solid var(--zv-border, #1e2736);
    border-radius: var(--zv-radius-lg, 14px);
    padding: 1.5rem;
  }

  @media (min-width: 640px) {
    .token-calc-container {
      padding: 2rem;
    }
  }

  .calc-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .badge-new {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    padding: 0.25rem 0.625rem;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #6ee7b7;
    border-radius: 9999px;
  }

  .calc-header h2 {
    margin: 0;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.025em;
  }

  .calc-header p {
    margin: 0 0 24px 0;
    color: var(--zv-text-muted, #94a3b8);
    font-size: 1rem;
    line-height: 1.6;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.75rem;
  }

  @media (max-width: 820px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .control-group {
    margin-bottom: 1.25rem;
  }

  .control-group:last-child {
    margin-bottom: 0;
  }

  .control-group label,
  .control-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
  }

  .calc-select {
    width: 100%;
    min-height: 44px;
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border-strong, #2d3a4f);
    color: #f8fafc;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 160ms var(--zv-ease-out);
  }

  .calc-select:hover {
    border-color: #475569;
  }

  .calc-select:focus-visible {
    border-color: var(--zv-accent, #10b981);
  }

  .scenario-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (max-width: 480px) {
    .scenario-buttons {
      grid-template-columns: 1fr;
    }
  }

  .scenario-btn {
    min-height: 44px;
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border-strong, #2d3a4f);
    color: var(--zv-text-secondary, #cbd5e1);
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background-color 160ms var(--zv-ease-out), border-color 160ms var(--zv-ease-out), color 160ms var(--zv-ease-out), transform 140ms var(--zv-ease-out);
  }

  .scenario-btn:hover:not(.active) {
    background: var(--zv-surface-elevated, #161d2b);
    border-color: #475569;
    color: #ffffff;
  }

  .scenario-btn:active {
    transform: scale(0.98);
  }

  .scenario-btn.active {
    background: #0c2a22;
    border-color: #10b981;
    color: #a7f3d0;
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .drop-zone {
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px dashed var(--zv-border-strong, #2d3a4f);
    background: var(--zv-bg, #090c12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    text-align: center;
    transition: border-color 160ms var(--zv-ease-out), background-color 160ms var(--zv-ease-out);
  }

  .drop-zone:hover,
  .drop-zone.dragover {
    border-color: var(--zv-accent, #10b981);
    background: rgba(16, 185, 129, 0.08);
  }

  .drop-zone-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--zv-text-muted, #94a3b8);
  }

  .drop-icon {
    width: 18px;
    height: 18px;
    color: #34d399;
    flex-shrink: 0;
  }

  .custom-dims-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .custom-dims-row {
      grid-template-columns: 1fr;
    }
  }

  .calc-slider {
    width: 100%;
    min-height: 44px;
    accent-color: #10b981;
    cursor: pointer;
  }

  .calc-results {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.875rem;
  }

  .metric-card {
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border, #1e2736);
    border-radius: var(--zv-radius-md, 10px);
    padding: 1.125rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .metric-card.savings-highlight {
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.35), var(--zv-bg, #090c12));
    border-color: rgba(16, 185, 129, 0.45);
  }

  .metric-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--zv-text-muted, #94a3b8);
    font-weight: 600;
    font-family: var(--sl-font-mono);
  }

  .savings-highlight .metric-label {
    color: #6ee7b7;
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0.25rem 0;
  }

  .savings-highlight .metric-value {
    color: #34d399;
  }

  .metric-sub {
    font-size: 0.8125rem;
    color: var(--zv-text-secondary, #cbd5e1);
    font-family: var(--sl-font-mono);
  }
</style>

<script>
  import {
    estimateVisionTokens,
    fitToTile,
    getProviderDimensions,
    percentSavings,
    type TargetProvider
  } from '../../../src/core/provider-math.ts';

  function setupCalculator() {
    const providerSelect = document.getElementById('provider-select') as HTMLSelectElement | null;
    const diffWidthInput = document.getElementById('diff-width') as HTMLInputElement | null;
    const diffHeightInput = document.getElementById('diff-height') as HTMLInputElement | null;
    const diffWVal = document.getElementById('diff-w-val');
    const diffHVal = document.getElementById('diff-h-val');
    const scenarioBtns = document.querySelectorAll<HTMLButtonElement>('.scenario-btn');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('image-upload-input') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status-text');

    const tokenSavingsPct = document.getElementById('token-savings-pct');
    const tokenComparison = document.getElementById('token-comparison');
    const byteSavingsPct = document.getElementById('byte-savings-pct');
    const byteComparison = document.getElementById('byte-comparison');
    const dimComparison = document.getElementById('dim-comparison');

    if (!providerSelect || !diffWidthInput || !diffHeightInput) return;

    let rawW = 1920;
    let rawH = 1080;
    let customFileBytes = 0;

    function update() {
      if (!providerSelect || !diffWidthInput || !diffHeightInput) return;
      const provider = providerSelect.value;
      const diffW = parseInt(diffWidthInput.value, 10);
      const diffH = parseInt(diffHeightInput.value, 10);

      if (diffWVal) diffWVal.textContent = diffW.toString();
      if (diffHVal) diffHVal.textContent = diffH.toString();

      const paddedW = diffW + 64;
      const paddedH = diffH + 64;

      // 'gemma-low' is the only <select> value that maps onto a different library provider.
      const lowTokenMode = provider === 'gemma-low';
      const libProvider = (lowTokenMode ? 'gemma' : provider) as TargetProvider;

      const tileDims = getProviderDimensions(libProvider, lowTokenMode);
      const { width: optW, height: optH } = fitToTile(paddedW, paddedH, tileDims);

      const rawTokens = estimateVisionTokens(rawW, rawH, libProvider, lowTokenMode);
      const optTokens = estimateVisionTokens(optW, optH, libProvider, lowTokenMode);
      const tokenSaved = percentSavings(rawTokens, optTokens);

      const rawKb = customFileBytes > 0
        ? Math.round(customFileBytes / 1024)
        : Math.round((rawW * rawH * 4) / 2000);
      const optKb = Math.max(4, Math.round((optW * optH * 0.15) / 1024) + 3);
      const byteSaved = percentSavings(rawKb, optKb);

      if (tokenSavingsPct) tokenSavingsPct.textContent = `${tokenSaved}%`;
      if (tokenComparison) tokenComparison.textContent = `${rawTokens.toLocaleString()} tokens → ${optTokens.toLocaleString()} tokens`;

      if (byteSavingsPct) byteSavingsPct.textContent = `${byteSaved}%`;
      if (byteComparison) byteComparison.textContent = `${rawKb.toLocaleString()} KB PNG → ~${optKb} KB WebP`;

      if (dimComparison) {
        dimComparison.textContent = `Raw ${rawW}×${rawH} → Optimized ${optW}×${optH} (no enlargement)`;
      }
    }

    function handleFile(file: File) {
      if (!file || !file.type.startsWith('image/') || !diffWidthInput || !diffHeightInput) return;
      customFileBytes = file.size;
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          rawW = img.naturalWidth || 1920;
          rawH = img.naturalHeight || 1080;
          diffWidthInput.max = rawW.toString();
          diffHeightInput.max = rawH.toString();
          diffWidthInput.value = Math.min(rawW, Math.round(rawW * 0.4)).toString();
          diffHeightInput.value = Math.min(rawH, Math.round(rawH * 0.4)).toString();

          scenarioBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          if (uploadStatus) {
            uploadStatus.textContent = `Loaded: ${file.name} (${rawW}×${rawH}px, ${Math.round(file.size / 1024)} KB)`;
          }
          update();
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    }

    if (dropZone && fileInput) {
      dropZone.onclick = () => fileInput.click();
      dropZone.onkeydown = (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      };
      dropZone.ondragover = (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      };
      dropZone.ondragleave = () => dropZone.classList.remove('dragover');
      dropZone.ondrop = (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer?.files?.[0]) {
          handleFile(e.dataTransfer.files[0]);
        }
      };
      fileInput.onchange = () => {
        if (fileInput.files?.[0]) {
          handleFile(fileInput.files[0]);
        }
      };
    }

    providerSelect.onchange = update;
    diffWidthInput.oninput = update;
    diffHeightInput.oninput = update;

    scenarioBtns.forEach((btn) => {
      btn.onclick = () => {
        scenarioBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        const w = parseInt(btn.getAttribute('data-w') || '120', 10);
        const h = parseInt(btn.getAttribute('data-h') || '48', 10);
        rawW = parseInt(btn.getAttribute('data-raw-w') || '1920', 10);
        rawH = parseInt(btn.getAttribute('data-raw-h') || '1080', 10);
        customFileBytes = 0;
        if (uploadStatus) {
          uploadStatus.textContent = 'Drop a PNG/JPG screenshot or click to browse';
        }

        diffWidthInput.max = rawW.toString();
        diffHeightInput.max = rawH.toString();
        diffWidthInput.value = w.toString();
        diffHeightInput.value = h.toString();
        update();
      };
    });

    update();
  }

  document.addEventListener('DOMContentLoaded', setupCalculator);
  document.addEventListener('astro:page-load', setupCalculator);
  setupCalculator();
</script>
