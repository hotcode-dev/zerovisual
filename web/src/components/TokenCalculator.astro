---
// Interactive Token & Byte Savings Calculator for ZeroVisual
---

<div class="token-calc-container">
  <div class="calc-header">
    <div class="calc-title-row">
      <h3>Interactive Token & Byte Savings Calculator</h3>
      <span class="badge-new">Updated: Multi-Model + Drop & Drop</span>
    </div>
    <p>See exactly how much AI token spend and network bandwidth ZeroVisual saves on your visual test failures or custom screenshots.</p>
  </div>

  <div class="calc-grid">
    <div class="calc-controls">
      <div class="control-group">
        <label for="provider-select">Target Vision Model Provider</label>
        <select id="provider-select" class="calc-select">
          <option value="anthropic" selected>Anthropic Claude 3.5 / 3.7 Sonnet (504×504 max tile)</option>
          <option value="openai">OpenAI GPT-4o / GPT-4o-mini (512×512 tile grid)</option>
          <option value="gemma">Google Gemma 4 / Gemini 2.0 (768×768 tile)</option>
          <option value="gemma-low">Google Gemma / Gemini Low-Token Mode (384×384 tile)</option>
          <option value="qwen">Qwen 2.5 / 3.8-VL (504×504 patch grid)</option>
          <option value="llama">Meta Llama 3.2 Vision (560×560 tile grid)</option>
          <option value="mistral">Mistral Pixtral (16×16 patch grid)</option>
          <option value="deepseek">DeepSeek-VL (384×384 tile grid)</option>
          <option value="local">Local VLM (448×448 grid)</option>
        </select>
      </div>

      <div class="control-group">
        <label>Diff Size Scenario Preset</label>
        <div class="scenario-buttons">
          <button type="button" class="scenario-btn active" data-w="120" data-h="48" data-raw-w="1920" data-raw-h="1080">Button Shift (120×48)</button>
          <button type="button" class="scenario-btn" data-w="380" data-h="140" data-raw-w="390" data-raw-h="844">Mobile Card (380×140)</button>
          <button type="button" class="scenario-btn" data-w="640" data-h="420" data-raw-w="1920" data-raw-h="1080">Modal Dialog (640×420)</button>
          <button type="button" class="scenario-btn" data-w="1600" data-h="800" data-raw-w="1920" data-raw-h="1080">Full Page Layout (1600×800)</button>
        </div>
      </div>

      <div class="control-group upload-group">
        <label for="image-upload-input">Or Upload / Drop Your Own Screenshot</label>
        <div class="drop-zone" id="drop-zone">
          <input type="file" id="image-upload-input" accept="image/*" class="sr-only" />
          <div class="drop-zone-content">
            <svg class="drop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span id="upload-status-text">Drop a PNG/JPG screenshot or click to browse</span>
          </div>
        </div>
      </div>

      <div class="custom-dims-row">
        <div class="control-group">
          <label for="diff-width">Diff Width: <span id="diff-w-val">120</span>px</label>
          <input type="range" id="diff-width" min="40" max="1920" value="120" step="10" class="calc-slider" />
        </div>
        <div class="control-group">
          <label for="diff-height">Diff Height: <span id="diff-h-val">48</span>px</label>
          <input type="range" id="diff-height" min="20" max="1080" value="48" step="10" class="calc-slider" />
        </div>
      </div>
    </div>

    <div class="calc-results">
      <div class="metric-card savings-highlight">
        <div class="metric-label">Vision Token Reduction</div>
        <div class="metric-value" id="token-savings-pct">98.9%</div>
        <div class="metric-sub" id="token-comparison">2,691 tokens ➔ 28 tokens</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Network / IPC Payload Size</div>
        <div class="metric-value" id="byte-savings-pct">99.8%</div>
        <div class="metric-sub" id="byte-comparison">4,200 KB ➔ ~9 KB WebP</div>
      </div>

      <div class="metric-card">
        <div class="metric-label">Model Context Clarity</div>
        <div class="metric-value" id="clarity-status">100% Focused</div>
        <div class="metric-sub" id="dim-comparison">Original 1920×1080 ➔ Cropped 184×112 (no upscale)</div>
      </div>
    </div>
  </div>
</div>

<style>
  .token-calc-container {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 27, 75, 0.85));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    padding: 1.75rem;
    margin: 2rem 0;
    box-shadow: 0 12px 32px -8px rgba(99, 102, 241, 0.2);
  }

  .calc-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .badge-new {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    border-radius: 9999px;
  }

  .calc-header h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: #e0e7ff;
  }

  .calc-header p {
    margin: 0 0 1.5rem 0;
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .control-group {
    margin-bottom: 1.25rem;
  }

  .control-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 0.4rem;
  }

  .calc-select {
    width: 100%;
    background: #0f172a;
    border: 1px solid #475569;
    color: #f8fafc;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .calc-select:focus {
    border-color: #6366f1;
  }

  .scenario-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .scenario-btn {
    background: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .scenario-btn:hover {
    background: #334155;
    color: #f8fafc;
  }

  .scenario-btn.active {
    background: #4f46e5;
    border-color: #6366f1;
    color: #ffffff;
    font-weight: 600;
  }

  .upload-group {
    margin-top: 0.5rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .drop-zone {
    border: 2px dashed rgba(99, 102, 241, 0.4);
    background: rgba(15, 23, 42, 0.6);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
  }

  .drop-zone:hover, .drop-zone.dragover {
    border-color: #818cf8;
    background: rgba(99, 102, 241, 0.1);
  }

  .drop-zone-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .drop-icon {
    width: 18px;
    height: 18px;
    color: #818cf8;
  }

  .custom-dims-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .calc-slider {
    width: 100%;
    accent-color: #6366f1;
    cursor: pointer;
  }

  .calc-results {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .metric-card {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 12px;
    padding: 1.15rem 1.25rem;
    transition: transform 0.2s ease;
  }

  .metric-card.savings-highlight {
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.5), rgba(15, 23, 42, 0.8));
    border-color: rgba(52, 211, 153, 0.4);
  }

  .metric-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
    font-weight: 600;
  }

  .savings-highlight .metric-label {
    color: #6ee7b7;
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1.2;
    margin: 0.25rem 0;
  }

  .savings-highlight .metric-value {
    color: #34d399;
  }

  .metric-sub {
    font-size: 0.85rem;
    color: #cbd5e1;
  }
</style>

<script>
  function setupCalculator() {
    const providerSelect = document.getElementById('provider-select') as HTMLSelectElement | null;
    const diffWidthInput = document.getElementById('diff-width') as HTMLInputElement | null;
    const diffHeightInput = document.getElementById('diff-height') as HTMLInputElement | null;
    const diffWVal = document.getElementById('diff-w-val');
    const diffHVal = document.getElementById('diff-h-val');
    const scenarioBtns = document.querySelectorAll('.scenario-btn');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('image-upload-input') as HTMLInputElement | null;
    const uploadStatus = document.getElementById('upload-status-text');

    const tokenSavingsPct = document.getElementById('token-savings-pct');
    const tokenComparison = document.getElementById('token-comparison');
    const byteSavingsPct = document.getElementById('byte-savings-pct');
    const byteComparison = document.getElementById('byte-comparison');
    const dimComparison = document.getElementById('dim-comparison');

    if (!providerSelect || !diffWidthInput || !diffHeightInput) return;

    let rawW = 1920;
    let rawH = 1080;
    let customFileBytes = 0;

    function calculateTokens(width: number, height: number, provider: string): number {
      if (provider === 'openai') {
        const tilesW = Math.ceil(width / 512);
        const tilesH = Math.ceil(height / 512);
        return 85 + (tilesW * tilesH * 170);
      } else if (provider === 'anthropic' || provider === 'qwen') {
        const patchesW = Math.ceil(width / 28);
        const patchesH = Math.ceil(height / 28);
        return patchesW * patchesH;
      } else if (provider === 'gemini' || provider === 'gemma' || provider === 'gemini-low' || provider === 'gemma-low') {
        const tileDim = (provider === 'gemini-low' || provider === 'gemma-low') ? 384 : 768;
        const tilesW = Math.ceil(width / tileDim);
        const tilesH = Math.ceil(height / tileDim);
        return tilesW * tilesH * 258;
      } else if (provider === 'llama') {
        const tilesW = Math.ceil(width / 560);
        const tilesH = Math.ceil(height / 560);
        return tilesW * tilesH * 324;
      } else if (provider === 'mistral') {
        const patchesW = Math.ceil(width / 16);
        const patchesH = Math.ceil(height / 16);
        return patchesW * patchesH;
      } else if (provider === 'deepseek') {
        const tilesW = Math.ceil(width / 384);
        const tilesH = Math.ceil(height / 384);
        return tilesW * tilesH * 576;
      } else {
        // Local default
        const patchesW = Math.ceil(width / 28);
        const patchesH = Math.ceil(height / 28);
        return patchesW * patchesH;
      }
    }

    function update() {
      const provider = providerSelect.value;
      const diffW = parseInt(diffWidthInput.value, 10);
      const diffH = parseInt(diffHeightInput.value, 10);

      if (diffWVal) diffWVal.textContent = diffW.toString();
      if (diffHVal) diffHVal.textContent = diffH.toString();

      // Bounding box with 32px clamped padding
      const paddedW = diffW + 64;
      const paddedH = diffH + 64;

      // Provider dimensions limit
      let maxTile = 504;
      if (provider === 'openai' || provider === 'mistral') maxTile = 512;
      else if (provider === 'gemini' || provider === 'gemma') maxTile = 768;
      else if (provider === 'gemini-low' || provider === 'gemma-low' || provider === 'deepseek') maxTile = 384;
      else if (provider === 'llama') maxTile = 560;
      else if (provider === 'local') maxTile = 448;

      // Model-aware downscale with withoutEnlargement: true
      let optW = paddedW;
      let optH = paddedH;
      if (optW > maxTile || optH > maxTile) {
        const ratio = Math.min(maxTile / optW, maxTile / optH);
        optW = Math.round(optW * ratio);
        optH = Math.round(optH * ratio);
      }

      // Token calculations
      const rawTokens = calculateTokens(rawW, rawH, provider);
      const optTokens = calculateTokens(optW, optH, provider);
      const tokenSaved = Math.max(0, Math.round(((rawTokens - optTokens) / rawTokens) * 1000) / 10);

      // Byte calculations
      const rawKb = customFileBytes > 0
        ? Math.round(customFileBytes / 1024)
        : Math.round((rawW * rawH * 4) / 2000);
      const optKb = Math.max(4, Math.round((optW * optH * 0.15) / 1024) + 3);
      const byteSaved = Math.max(0, Math.round(((rawKb - optKb) / rawKb) * 1000) / 10);

      if (tokenSavingsPct) tokenSavingsPct.textContent = `${tokenSaved}%`;
      if (tokenComparison) tokenComparison.textContent = `${rawTokens.toLocaleString()} tokens ➔ ${optTokens.toLocaleString()} tokens`;

      if (byteSavingsPct) byteSavingsPct.textContent = `${byteSaved}%`;
      if (byteComparison) byteComparison.textContent = `${rawKb.toLocaleString()} KB PNG ➔ ~${optKb} KB WebP`;

      if (dimComparison) {
        dimComparison.textContent = `Raw ${rawW}×${rawH} ➔ Optimized ${optW}×${optH} (no enlargement)`;
      }
    }

    // Drag-and-drop / File upload handler
    function handleFile(file: File) {
      if (!file || !file.type.startsWith('image/')) return;
      customFileBytes = file.size;
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          rawW = img.naturalWidth || 1920;
          rawH = img.naturalHeight || 1080;
          diffWidthInput.max = rawW.toString();
          diffHeightInput.max = rawH.toString();
          diffWidthInput.value = Math.min(rawW, Math.round(rawW * 0.4)).toString();
          diffHeightInput.value = Math.min(rawH, Math.round(rawH * 0.4)).toString();

          scenarioBtns.forEach((b) => b.classList.remove('active'));
          if (uploadStatus) {
            uploadStatus.textContent = `Loaded: ${file.name} (${rawW}×${rawH}px, ${Math.round(file.size / 1024)} KB)`;
          }
          update();
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    }

    if (dropZone && fileInput) {
      dropZone.addEventListener('click', () => fileInput.click());
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
      });
      dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer?.files?.[0]) {
          handleFile(e.dataTransfer.files[0]);
        }
      });
      fileInput.addEventListener('change', () => {
        if (fileInput.files?.[0]) {
          handleFile(fileInput.files[0]);
        }
      });
    }

    providerSelect.addEventListener('change', update);
    diffWidthInput.addEventListener('input', update);
    diffHeightInput.addEventListener('input', update);

    scenarioBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        scenarioBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const w = parseInt(btn.getAttribute('data-w') || '120', 10);
        const h = parseInt(btn.getAttribute('data-h') || '48', 10);
        rawW = parseInt(btn.getAttribute('data-raw-w') || '1920', 10);
        rawH = parseInt(btn.getAttribute('data-raw-h') || '1080', 10);
        customFileBytes = 0;
        if (uploadStatus) {
          uploadStatus.textContent = 'Drop a PNG/JPG screenshot or click to browse';
        }

        diffWidthInput.value = w.toString();
        diffHeightInput.value = h.toString();
        update();
      });
    });

    update();
  }

  // Handle client-side navigation in Astro
  document.addEventListener('DOMContentLoaded', setupCalculator);
  setupCalculator();
</script>
