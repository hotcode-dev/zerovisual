---
// Premium Side-by-Side Visual Regression & Image Optimization Comparison
import githubDiffCanvas from '../assets/github-diff-canvas.webp';
import githubCrop from '../assets/github-zerovisual-crop.webp';
import githubMobileDiff from '../assets/github-mobile-diff.webp';
import githubMobileCrop from '../assets/github-mobile-crop.webp';
---

<div class="compare-wrapper">
  <!-- Top Feature Pill -->
  <div class="pill-banner">
    <span class="live-dot"></span>
    <span class="pill-text">Responsive Multi-Viewport Testing</span>
    <span class="pill-divider">/</span>
    <span class="pill-stat">Desktop + Mobile Aggregation</span>
  </div>

  <div class="compare-header">
    <h3>Real-World Responsive Visual Regression Triage</h3>
    <p>
      See how ZeroVisual intercepts Playwright failures across both Desktop and Mobile viewports, isolates the diffs, and aggregates them into a single <code>triage-ready.json</code> payload.
    </p>
  </div>

  <!-- Scenario Tabs -->
  <div class="scenario-nav">
    <button type="button" class="scenario-tab active" data-scenario="desktop">
      <span class="tab-icon">🖥️</span>
      <span class="tab-title">Desktop Chrome (1920×1080)</span>
      <span class="tab-badge-emerald">-98.9% Tokens</span>
    </button>
    <button type="button" class="scenario-tab" data-scenario="mobile">
      <span class="tab-icon">📱</span>
      <span class="tab-title">Mobile Safari (390×844)</span>
      <span class="tab-badge-emerald">-87.5% Tokens</span>
    </button>
    <button type="button" class="scenario-tab" data-scenario="aggregation">
      <span class="tab-icon">⚡️</span>
      <span class="tab-title">Multi-Viewport Aggregation</span>
      <span class="tab-badge-cyan">1 Prompt</span>
    </button>
    <button type="button" class="scenario-tab" data-scenario="slider">
      <span class="tab-icon">↔️</span>
      <span class="tab-title">Split Slider</span>
    </button>
  </div>

  <!-- View 1: Desktop Chrome -->
  <div id="scenario-desktop" class="scenario-content active">
    <div class="browser-window">
      <div class="browser-toolbar">
        <div class="window-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="url-bar">
          <svg class="lock-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="url-text">https://github.com/hotcode-dev/zerovisual [Desktop Chrome]</span>
        </div>
        <div class="test-status-badge fail">
          <span>● Playwright: FAILED</span>
        </div>
      </div>

      <div class="comparison-grid">
        <!-- Left: Full HD GitHub Screenshot -->
        <div class="compare-card raw-card">
          <div class="card-top-bar">
            <div class="card-badge raw">Before: Full 1920×1080 Canvas</div>
            <div class="card-token-counter text-red">2,691 Tokens</div>
          </div>
          <div class="image-stage">
            <img
              src={githubDiffCanvas.src}
              alt="Raw 1920x1080 GitHub page with Playwright visual regression diff"
              class="stage-image full-canvas"
              loading="lazy"
            />
            <div class="crop-bounding-indicator github-indicator">
              <span class="indicator-chip">Repository Header (32px Clamped Padding)</span>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value">1920 × 1080 px</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Base64 Payload</span>
              <span class="cell-value text-red">~2,100 KB</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Anthropic Tokens</span>
              <span class="cell-value text-red">2,691 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Context Noise</span>
              <span class="cell-value text-red">92% Noise</span>
            </div>
          </div>
        </div>

        <!-- Right: ZeroVisual Cropped & Model Aligned -->
        <div class="compare-card opt-card">
          <div class="card-top-bar">
            <div class="card-badge opt">After: ZeroVisual Component Isolation</div>
            <div class="card-token-counter text-emerald">90 Tokens (-96.7%)</div>
          </div>
          <div class="image-stage crop-stage">
            <div class="crop-focus-frame">
              <img
                src={githubCrop.src}
                alt="ZeroVisual model-aligned crop of GitHub repository header component"
                class="stage-image crop-result"
                loading="lazy"
              />
            </div>
            <div class="patch-info-pill">
              <span>18 × 5 Grid = 90 Patches (Exact 1-Tile Fit)</span>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value text-emerald">504 × 126 px (Model Aligned)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">WebP Payload</span>
              <span class="cell-value text-emerald">5.6 KB (99.7% smaller)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Anthropic Tokens</span>
              <span class="cell-value text-emerald">90 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Visual Focus</span>
              <span class="cell-value text-emerald">100% Focused</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Mobile Safari (iPhone 14) -->
  <div id="scenario-mobile" class="scenario-content">
    <div class="browser-window mobile-window">
      <div class="browser-toolbar">
        <div class="window-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="url-bar">
          <span class="url-text">https://github.com/hotcode-dev/zerovisual [iPhone 14]</span>
        </div>
        <div class="test-status-badge fail">
          <span>● Playwright: FAILED</span>
        </div>
      </div>

      <div class="comparison-grid mobile-grid">
        <!-- Left: Full Mobile Viewport -->
        <div class="compare-card raw-card mobile-frame-card">
          <div class="card-top-bar">
            <div class="card-badge raw">Before: Full Mobile Screen</div>
            <div class="card-token-counter text-red">450 Tokens</div>
          </div>
          <div class="image-stage mobile-stage">
            <div class="iphone-frame">
              <img
                src={githubMobileDiff.src}
                alt="Raw 390x844 iPhone screenshot with diff overlay"
                class="stage-image iphone-screen"
                loading="lazy"
              />
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Viewport</span>
              <span class="cell-value">390 × 844 px</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Payload Size</span>
              <span class="cell-value text-red">~172 KB</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Vision Tokens</span>
              <span class="cell-value text-red">450 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Signal-to-Noise</span>
              <span class="cell-value text-red">Full Screen</span>
            </div>
          </div>
        </div>

        <!-- Right: ZeroVisual Mobile Clamped Crop -->
        <div class="compare-card opt-card">
          <div class="card-top-bar">
            <div class="card-badge opt">After: ZeroVisual Mobile Crop</div>
            <div class="card-token-counter text-emerald">140 Tokens (-68.9%)</div>
          </div>
          <div class="image-stage crop-stage">
            <div class="crop-focus-frame">
              <img
                src={githubMobileCrop.src}
                alt="ZeroVisual cropped mobile header diff"
                class="stage-image crop-result"
                loading="lazy"
              />
            </div>
            <div class="patch-info-pill">
              <span>14 × 10 Grid = 140 Patches</span>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value text-emerald">390 × 280 px (Mobile Header)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">WebP Payload</span>
              <span class="cell-value text-emerald">1.2 KB (99.3% smaller)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Vision Tokens</span>
              <span class="cell-value text-emerald">140 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Visual Focus</span>
              <span class="cell-value text-emerald">100% Focused</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Multi-Viewport Aggregation -->
  <div id="scenario-aggregation" class="scenario-content">
    <div class="aggregation-card">
      <div class="agg-header">
        <div class="agg-badge">Feature 5: Multi-Viewport Correlation</div>
        <h4>One Single Prompt Diagnoses Desktop + Mobile Breakpoints</h4>
        <p>
          Instead of triggering multiple disconnected AI reviews for the same broken CSS layout, ZeroVisual groups Desktop Chrome and Mobile Safari under a single normalized <code>testId</code> in <code>triage-ready.json</code>:
        </p>
      </div>

      <div class="agg-visual-flow">
        <div class="agg-box">
          <div class="box-title">Desktop Chrome (1920×1080)</div>
          <div class="box-crop">
            <img src={githubCrop.src} alt="Desktop Crop" />
          </div>
          <div class="box-tokens">90 Tokens (5.6 KB)</div>
        </div>

        <div class="agg-plus">+</div>

        <div class="agg-box">
          <div class="box-title">Mobile Safari (390×844)</div>
          <div class="box-crop">
            <img src={githubMobileCrop.src} alt="Mobile Crop" />
          </div>
          <div class="box-tokens">140 Tokens (1.2 KB)</div>
        </div>

        <div class="agg-equals">=</div>

        <div class="agg-bundle-result">
          <div class="bundle-tag">Normalized testId: "tests/repo.spec.ts:header"</div>
          <div class="bundle-stat">Total: 230 Tokens (6.8 KB Payload)</div>
          <div class="bundle-compare">Without ZeroVisual: 3,141 Tokens (2.3 MB)</div>
          <div class="bundle-savings">92.7% Total Token Savings across Viewports!</div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 4: Split Slider -->
  <div id="scenario-slider" class="scenario-content">
    <div class="slider-interactive-wrapper">
      <div class="slider-container-box" id="github-split-slider">
        <img
          src={githubDiffCanvas.src}
          alt="GitHub Full Canvas"
          class="slider-img base-layer"
        />
        <div class="slider-reveal-layer" id="github-slider-overlay">
          <img
            src={githubDiffCanvas.src}
            alt="GitHub Overlay Layer"
            class="slider-img"
          />
          <div class="slider-crop-guide" style="left: 59.5%; top: 24.5%; width: 6.5%; height: 3.5%;">
            <span class="guide-tag">Target Bounding Box</span>
          </div>
        </div>
        <div class="slider-divider-line" id="github-slider-handle">
          <div class="slider-thumb">↔</div>
        </div>
      </div>
      <div class="slider-caption-bar">
        <span>◀ Raw 1920×1080 Screenshot</span>
        <span>Drag to inspect detected diff region ▶</span>
      </div>
    </div>
  </div>
</div>

<style>
  .compare-wrapper {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(11, 15, 25, 0.98));
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 20px;
    padding: 2rem;
    margin: 2.5rem 0;
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.7);
    position: relative;
    overflow: hidden;
  }

  .pill-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 9999px;
    font-size: 0.8rem;
    color: #cbd5e1;
    margin-bottom: 1rem;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .pill-divider { color: #475569; }
  .pill-stat { color: #34d399; font-weight: 700; }

  .compare-header h3 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .compare-header p {
    color: #94a3b8;
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0 0 1.75rem 0;
    max-width: 850px;
  }

  .scenario-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .scenario-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 10px;
    color: #cbd5e1;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scenario-tab:hover {
    background: rgba(51, 65, 85, 0.8);
    border-color: #818cf8;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .scenario-tab.active {
    background: #6366f1;
    border-color: #818cf8;
    color: #ffffff;
    box-shadow: 0 4px 16px -2px rgba(99, 102, 241, 0.6);
  }

  .tab-badge-emerald {
    background: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    font-weight: 700;
  }

  .tab-badge-cyan {
    background: rgba(6, 182, 212, 0.2);
    color: #67e8f9;
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    font-weight: 700;
  }

  .scenario-tab.active .tab-badge-emerald,
  .scenario-tab.active .tab-badge-cyan {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  .scenario-content { display: none; }
  .scenario-content.active { display: block; }

  .browser-window {
    background: #090d16;
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.6);
  }

  .browser-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: rgba(30, 41, 59, 0.6);
    border-bottom: 1px solid rgba(51, 65, 85, 0.4);
    gap: 1rem;
  }

  .window-dots { display: flex; gap: 6px; }
  .dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .url-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.35);
    border-radius: 6px;
    padding: 0.3rem 0.85rem;
    font-size: 0.8rem;
    color: #94a3b8;
    flex: 1;
    max-width: 480px;
    font-family: var(--sl-font-mono);
  }

  .test-status-badge.fail {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: rgba(11, 15, 25, 0.8);
  }

  @media (max-width: 960px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }

  .compare-card {
    background: rgba(15, 23, 42, 0.9);
    border-radius: 12px;
    border: 1px solid rgba(71, 85, 105, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .compare-card.opt-card {
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 0 20px -5px rgba(16, 185, 129, 0.15);
  }

  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: rgba(30, 41, 59, 0.4);
    border-bottom: 1px solid rgba(51, 65, 85, 0.3);
  }

  .card-badge { font-size: 0.8rem; font-weight: 700; }
  .card-badge.raw { color: #f87171; }
  .card-badge.opt { color: #34d399; }
  .card-token-counter { font-size: 0.85rem; font-weight: 800; }
  .text-red { color: #f87171; }
  .text-emerald { color: #34d399; }

  .image-stage {
    position: relative;
    background: #020617;
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    overflow: hidden;
  }

  .stage-image {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }

  .github-indicator {
    position: absolute;
    left: 16.7%;
    top: 10.2%;
    width: 66.7%;
    height: 29.6%;
    border: 2px dashed #f43f5e;
    background: rgba(244, 63, 94, 0.15);
    border-radius: 4px;
    pointer-events: none;
    animation: pulseIndicator 2s infinite;
  }

  @keyframes pulseIndicator {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0.3; }
  }

  .indicator-chip {
    position: absolute;
    top: -22px;
    left: 50%;
    transform: translateX(-50%);
    background: #f43f5e;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .crop-stage {
    background: radial-gradient(circle at center, rgba(30, 41, 59, 0.9), #040812);
    padding: 2.5rem 1.5rem;
  }

  .crop-focus-frame {
    padding: 6px;
    border: 2px solid rgba(52, 211, 153, 0.6);
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.95);
    box-shadow: 0 10px 30px -5px rgba(16, 185, 129, 0.3);
  }

  .patch-info-pill {
    position: absolute;
    bottom: 12px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #a7f3d0;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 9999px;
  }

  .card-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 1rem;
    border-top: 1px solid rgba(51, 65, 85, 0.3);
    background: rgba(15, 23, 42, 0.6);
  }

  .metric-cell { display: flex; flex-direction: column; }
  .cell-label {
    font-size: 0.72rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .cell-value { font-size: 0.92rem; font-weight: 700; color: #f1f5f9; }

  /* Mobile Frame Styling */
  .mobile-stage {
    padding: 1rem;
  }
  .iphone-frame {
    max-width: 200px;
    border: 4px solid #334155;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }
  .iphone-screen {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Multi-Viewport Aggregation Card */
  .aggregation-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.4), rgba(15, 23, 42, 0.8));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 14px;
    padding: 2rem;
  }

  .agg-header {
    margin-bottom: 2rem;
  }

  .agg-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #818cf8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .agg-header h4 {
    font-size: 1.4rem;
    color: #f8fafc;
    margin: 0 0 0.5rem 0;
  }

  .agg-header p {
    color: #94a3b8;
    margin: 0;
    line-height: 1.5;
  }

  .agg-visual-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .agg-box {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
    width: 200px;
  }

  .box-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
  }

  .box-crop img {
    max-width: 100%;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid rgba(52, 211, 153, 0.4);
  }

  .box-tokens {
    font-size: 0.85rem;
    font-weight: 700;
    color: #34d399;
    margin-top: 0.5rem;
  }

  .agg-plus, .agg-equals {
    font-size: 1.6rem;
    font-weight: 800;
    color: #6366f1;
  }

  .agg-bundle-result {
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.4), rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(52, 211, 153, 0.5);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    min-width: 280px;
  }

  .bundle-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.4rem;
  }

  .bundle-stat {
    font-size: 1.15rem;
    font-weight: 800;
