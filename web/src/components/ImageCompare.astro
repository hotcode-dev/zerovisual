<script>
  import { setGroupActive } from '../lib/toggle-group.ts';

  function setupImageCompareTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.scenario-tab'));
    const contents = Array.from(document.querySelectorAll<HTMLElement>('.scenario-content'));
    if (!tabs.length) return;

    function activateTab(tab: HTMLButtonElement) {
      setGroupActive(tabs, tab, 'aria-selected');
      contents.forEach((c) => {
        c.classList.remove('active');
        c.hidden = true;
      });

      const scenario = tab.getAttribute('data-scenario');
      const target = document.getElementById(`scenario-${scenario}`);
      if (target) {
        target.hidden = false;
        target.classList.add('active');
      }
    }

    tabs.forEach((tab, index) => {
      tab.onclick = () => activateTab(tab);
      tab.onkeydown = (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          const next = tabs[(index + 1) % tabs.length];
          next.focus();
          activateTab(next);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = tabs[(index - 1 + tabs.length) % tabs.length];
          prev.focus();
          activateTab(prev);
        }
      };
    });
  }

  setupImageCompareTabs();
</script>
