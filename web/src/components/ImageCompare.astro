<script>
  function setupInteractiveImageCompare() {
    const tabs = document.querySelectorAll('.scenario-tab');
    const contents = document.querySelectorAll('.scenario-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));

        tab.classList.add('active');
        const scenario = tab.getAttribute('data-scenario');
        const target = document.getElementById(`scenario-${scenario}`);
        if (target) target.classList.add('active');
      });
    });

    // Slider
    const sliderBox = document.getElementById('github-split-slider');
    const overlay = document.getElementById('github-slider-overlay');
    const handle = document.getElementById('github-slider-handle');

    if (!sliderBox || !overlay || !handle) return;

    let dragging = false;

    function move(clientX: number) {
      const rect = sliderBox.getBoundingClientRect();
      const posX = Math.max(0, Math.min(clientX - rect.left, rect.width));
      const pct = (posX / rect.width) * 100;

      overlay.style.width = `${pct}%`;
      handle.style.left = `${pct}%`;
    }

    sliderBox.addEventListener('mousedown', (e) => {
      dragging = true;
      move(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      dragging = false;
    });

    window.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      move(e.clientX);
    });

    sliderBox.addEventListener('touchstart', (e) => {
      dragging = true;
      if (e.touches[0]) move(e.touches[0].clientX);
    });

    window.addEventListener('touchend', () => {
      dragging = false;
    });

    window.addEventListener('touchmove', (e) => {
      if (!dragging || !e.touches[0]) return;
      move(e.touches[0].clientX);
    });
  }

  document.addEventListener('DOMContentLoaded', setupInteractiveImageCompare);
  setupInteractiveImageCompare();
</script>
