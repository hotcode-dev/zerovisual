---
// High-Fidelity Wikipedia Visual Regression & Token Optimization Showcase
import wikiDiffFull from '../assets/wiki-diff-full.webp';
import wikiDiffCrop from '../assets/wiki-diff-crop.webp';
import wikiDiffMobile from '../assets/wiki-diff-mobile.webp';
import wikiDiffMobileCrop from '../assets/wiki-diff-mobile-crop.webp';
---

<div class="compare-wrapper not-content">
  <!-- Top Feature Pill -->
  <div class="pill-banner">
    <span class="live-dot" aria-hidden="true"></span>
    <span class="pill-text">ZeroVisual in Action</span>
    <span class="pill-divider" aria-hidden="true">/</span>
    <span class="pill-stat">Wikipedia Portal (wikipedia.org)</span>
  </div>

  <div class="compare-header">
    <h2 id="showcase-heading">Automated Visual Regression Triage</h2>
    <p>
      In a Playwright E2E test for <strong>wikipedia.org</strong>, an unexpected +8px button padding shift causes <code>#search-form</code> to fail visual comparison. Without ZeroVisual, AI agents receive full-viewport screenshots overloaded with irrelevant whitespace. ZeroVisual isolates the defect, aligns it to model-native vision tiles, and delivers clean context:
    </p>
  </div>

  <!-- Scenario Tabs -->
  <div class="scenario-nav" role="tablist" aria-label="Visual regression comparison scenarios">
    <button
      type="button"
      id="btn-tab-desktop"
      role="tab"
      aria-selected="true"
      aria-controls="scenario-desktop"
      class="scenario-tab active"
      data-scenario="desktop"
    >
      <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <path d="M8 21h8M12 17v4"></path>
      </svg>
      <span class="tab-title">Desktop (1280×800)</span>
      <span class="tab-badge-emerald tabular-nums">-77.1%</span>
    </button>
    <button
      type="button"
      id="btn-tab-mobile"
      role="tab"
      aria-selected="false"
      aria-controls="scenario-mobile"
      class="scenario-tab"
      data-scenario="mobile"
    >
      <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="5" y="2" width="14" height="20" rx="2"></rect>
        <path d="M12 18h.01"></path>
      </svg>
      <span class="tab-title">Mobile (390×844)</span>
      <span class="tab-badge-emerald tabular-nums">-92.0%</span>
    </button>
    <button
      type="button"
      id="btn-tab-aggregation"
      role="tab"
      aria-selected="false"
      aria-controls="scenario-aggregation"
      class="scenario-tab"
      data-scenario="aggregation"
    >
      <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
      </svg>
      <span class="tab-title">Multi-Viewport</span>
      <span class="tab-badge-cyan">1 Prompt</span>
    </button>
  </div>

  <!-- View 1: Desktop Wikipedia -->
  <div id="scenario-desktop" role="tabpanel" aria-labelledby="btn-tab-desktop" class="scenario-content active">
    <div class="browser-window">
      <div class="browser-toolbar">
        <div class="window-dots" aria-hidden="true">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="url-bar">
          <svg class="lock-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="url-text">https://www.wikipedia.org/ [Desktop Chrome]</span>
        </div>
        <div class="test-status-badge fail">
          <span aria-hidden="true">●</span>
          <span>FAILED: wikipedia.spec.ts</span>
        </div>
      </div>

      <div class="comparison-grid">
        <!-- Left: Full 1280x800 Wikipedia Page -->
        <div class="compare-card raw-card">
          <div class="card-top-bar">
            <div class="card-badge raw">Before: Full 1280×800 Viewport</div>
            <div class="card-token-counter text-red tabular-nums">1,334 Tokens</div>
          </div>
          <div class="image-stage">
            <div class="canvas-viewport-frame">
              <img
                src={wikiDiffFull.src}
                alt="Raw 1280x800 Wikipedia homepage with Search Box failure"
                class="stage-image full-canvas"
                loading="eager"
              />
              <div class="crop-bounding-indicator wiki-desktop-indicator" aria-hidden="true">
                <span class="indicator-chip">Search Component (+8px Shift)</span>
              </div>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value tabular-nums">1280 × 800 px</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Base64 Payload</span>
              <span class="cell-value text-red tabular-nums">~1,200 KB</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Anthropic Tokens</span>
              <span class="cell-value text-red tabular-nums">1,334 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Visual Noise</span>
              <span class="cell-value text-red">66% Irrelevant Content</span>
            </div>
          </div>
        </div>

        <!-- Right: ZeroVisual Cropped & Model Aligned -->
        <div class="compare-card opt-card">
          <div class="card-top-bar">
            <div class="card-badge opt">After: ZeroVisual Model-Aligned Crop</div>
            <div class="card-token-counter text-emerald tabular-nums">306 Tokens (-77.1%)</div>
          </div>
          <div class="image-stage crop-stage">
            <div class="crop-focus-frame">
              <img
                src={wikiDiffCrop.src}
                alt="ZeroVisual model-aligned crop of Wikipedia Search Component"
                class="stage-image crop-result"
                loading="eager"
              />
            </div>
            <div class="patch-info-pill tabular-nums">
              <span>18 × 16 Grid = 288 Patches (1-Tile Fit)</span>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value text-emerald tabular-nums">504 × 457 px (Single Tile)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">WebP Payload</span>
              <span class="cell-value text-emerald tabular-nums">21.0 KB (98.2% smaller)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Anthropic Tokens</span>
              <span class="cell-value text-emerald tabular-nums">306 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Model Focus</span>
              <span class="cell-value text-emerald">100% on Search Defect</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 2: Mobile Wikipedia -->
  <div id="scenario-mobile" role="tabpanel" aria-labelledby="btn-tab-mobile" class="scenario-content" hidden>
    <div class="browser-window">
      <div class="browser-toolbar">
        <div class="window-dots" aria-hidden="true">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="url-bar">
          <svg class="lock-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="url-text">https://www.wikipedia.org/ [iPhone 14 Safari]</span>
        </div>
        <div class="test-status-badge fail">
          <span aria-hidden="true">●</span>
          <span>FAILED: Mobile Viewport</span>
        </div>
      </div>

      <div class="comparison-grid">
        <!-- Left: Full Mobile Screen -->
        <div class="compare-card raw-card">
          <div class="card-top-bar">
            <div class="card-badge raw">Before: Full Mobile Viewport</div>
            <div class="card-token-counter text-red tabular-nums">336 – 3,024 Tokens</div>
          </div>
          <div class="image-stage">
            <div class="phone-frame">
              <img
                src={wikiDiffMobile.src}
                alt="Raw iPhone Wikipedia page with Search Button shift"
                class="stage-image phone-screen"
                loading="lazy"
              />
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Viewport</span>
              <span class="cell-value tabular-nums">390 × 664 px</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Payload Size</span>
              <span class="cell-value text-red tabular-nums">~250 KB – 2.5 MB</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Vision Tokens</span>
              <span class="cell-value text-red tabular-nums">336 – 3,024 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Signal-to-Noise</span>
              <span class="cell-value text-red">Full Screen Overload</span>
            </div>
          </div>
        </div>

        <!-- Right: ZeroVisual Mobile Component Crop -->
        <div class="compare-card opt-card">
          <div class="card-top-bar">
            <div class="card-badge opt">After: ZeroVisual Mobile Crop</div>
            <div class="card-token-counter text-emerald tabular-nums">238 Tokens (-92.0%)</div>
          </div>
          <div class="image-stage crop-stage">
            <div class="crop-focus-frame">
              <img
                src={wikiDiffMobileCrop.src}
                alt="ZeroVisual cropped mobile Wikipedia Search component"
                class="stage-image crop-result"
                loading="lazy"
              />
            </div>
            <div class="patch-info-pill tabular-nums">
              <span>14 × 17 Grid = 238 Patches</span>
            </div>
          </div>
          <div class="card-metrics-grid">
            <div class="metric-cell">
              <span class="cell-label">Resolution</span>
              <span class="cell-value text-emerald tabular-nums">390 × 470 px (No Upscale)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">WebP Payload</span>
              <span class="cell-value text-emerald tabular-nums">17.3 KB (93% smaller)</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Vision Tokens</span>
              <span class="cell-value text-emerald tabular-nums">238 tokens</span>
            </div>
            <div class="metric-cell">
              <span class="cell-label">Visual Focus</span>
              <span class="cell-value text-emerald">100% on Mobile Defect</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- View 3: Multi-Viewport Aggregation -->
  <div id="scenario-aggregation" role="tabpanel" aria-labelledby="btn-tab-aggregation" class="scenario-content" hidden>
    <div class="aggregation-card">
      <div class="agg-header">
        <div class="agg-badge">Multi-Viewport Correlation</div>
        <h3>One Single Prompt Diagnoses Responsive Breakpoints</h3>
        <p>
          Instead of triggering separate AI reviews with disconnected full-page screenshots, ZeroVisual correlates Desktop Chrome and Mobile Safari under a single normalized <code>testId</code> in <code>triage-ready.json</code>:
        </p>
      </div>

      <div class="agg-visual-flow">
        <div class="agg-box">
          <div class="box-title">Desktop Chrome (1280×800)</div>
          <div class="box-crop">
            <img src={wikiDiffCrop.src} alt="Desktop Wikipedia Crop" loading="lazy" />
          </div>
          <div class="box-tokens tabular-nums">306 Tokens (21.0 KB)</div>
        </div>

        <div class="agg-operator" aria-hidden="true">+</div>

        <div class="agg-box">
          <div class="box-title">Mobile Safari (390×844)</div>
          <div class="box-crop">
            <img src={wikiDiffMobileCrop.src} alt="Mobile Wikipedia Crop" loading="lazy" />
          </div>
          <div class="box-tokens tabular-nums">238 Tokens (17.3 KB)</div>
        </div>

        <div class="agg-operator" aria-hidden="true">=</div>

        <div class="agg-bundle-result">
          <div class="bundle-tag">Normalized testId: "tests/wikipedia.spec.ts:search"</div>
          <div class="bundle-stat tabular-nums">544 Total Tokens (38.3 KB Payload)</div>
          <div class="bundle-compare tabular-nums">Without ZeroVisual: 1,670 to 4,358 Tokens</div>
          <div class="bundle-savings">Up to 87.5% Token Savings Across Viewports</div>
        </div>
      </div>

      <div class="triage-json-preview">
        <div class="json-header">
          <span class="json-dot" aria-hidden="true"></span>
          <span>triage-ready.json (Delivered to AI Coding Agent)</span>
        </div>
        <pre><code>{`{
  "testId": "tests/wikipedia.spec.ts:search-input",
  "status": "failed",
  "diff": {
    "desktop_chrome": {
      "tokens": 306,
      "tileGrid": "18x16",
      "image": "data:image/webp;base64,UklGRm..."
    },
    "mobile_safari": {
      "tokens": 238,
      "tileGrid": "14x17",
      "image": "data:image/webp;base64,UklGRn..."
    }
  },
  "totalTokens": 544,
  "savingsPercent": 77.1
}`}</code></pre>
      </div>
    </div>
  </div>
</div>

<style>
  .compare-wrapper {
    background: var(--zv-surface, #0f141e);
    border: 1px solid var(--zv-border, #1e2736);
    border-radius: var(--zv-radius-lg, 14px);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .compare-wrapper {
      padding: 2rem;
    }
  }

  .pill-banner {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 12px;
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border-strong, #2d3a4f);
    border-radius: 8px;
    font-size: 0.75rem;
    color: var(--zv-text-secondary, #cbd5e1);
    margin-bottom: 16px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
  }

  .pill-divider { color: #475569; }
  .pill-stat { color: #6ee7b7; font-weight: 600; font-family: var(--sl-font-mono); }

  .compare-header h2 {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 8px 0;
    letter-spacing: -0.025em;
  }

  .compare-header p {
    color: var(--zv-text-muted, #94a3b8);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 24px 0;
    max-width: 52rem;
  }

  /* Scenario Tabs: 3 Equal Columns, 48px touch targets */
  .scenario-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
    padding: 0.25rem;
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border, #1e2736);
    border-radius: var(--zv-radius-md, 10px);
  }

  @media (max-width: 680px) {
    .scenario-nav {
      grid-template-columns: 1fr;
    }
  }

  .scenario-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--zv-text-muted, #94a3b8);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    width: 100%;
    min-height: 44px;
    transition: background-color 160ms var(--zv-ease-out), color 160ms var(--zv-ease-out), border-color 160ms var(--zv-ease-out), transform 140ms var(--zv-ease-out);
  }

  .tab-svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .scenario-tab:hover:not(.active) {
    background: var(--zv-surface-elevated, #161d2b);
    color: #f8fafc;
  }

  .scenario-tab:active {
    transform: scale(0.985);
  }

  .scenario-tab.active {
    background: var(--zv-surface-elevated, #161d2b);
    border-color: rgba(16, 185, 129, 0.45);
    color: #ffffff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .tab-badge-emerald {
    background: rgba(16, 185, 129, 0.16);
    color: #6ee7b7;
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    font-family: var(--sl-font-mono);
  }

  .tab-badge-cyan {
    background: rgba(34, 211, 238, 0.14);
    color: #67e8f9;
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-weight: 700;
    font-family: var(--sl-font-mono);
  }

  .scenario-content {
    display: none;
  }

  .scenario-content.active {
    display: block;
    animation: zvPanelIn 220ms var(--zv-ease-out) both;
  }

  @keyframes zvPanelIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Browser Window Mockup */
  .browser-window {
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border-strong, #2d3a4f);
    border-radius: var(--zv-radius-md, 10px);
    overflow: hidden;
  }

  .browser-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    background: var(--zv-surface-elevated, #161d2b);
    border-bottom: 1px solid var(--zv-border, #1e2736);
    gap: 0.75rem;
  }

  .window-dots { display: flex; gap: 6px; flex-shrink: 0; }
  .dot { width: 10px; height: 10px; border-radius: 50%; opacity: 0.85; }
  .dot.red { background: #fb7185; }
  .dot.yellow { background: #fbbf24; }
  .dot.green { background: #34d399; }

  .url-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--zv-bg, #090c12);
    border: 1px solid var(--zv-border, #1e2736);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    color: var(--zv-text-muted, #94a3b8);
    flex: 1 1 200px;
    min-width: 0;
    max-width: 520px;
    font-family: var(--sl-font-mono);
  }

  .url-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lock-icon { flex-shrink: 0; color: #64748b; }

  .test-status-badge.fail {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(225, 29, 72, 0.14);
    border: 1px solid rgba(251, 113, 133, 0.35);
    color: #fda4af;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    padding: 0.25rem 0.625rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  /* Comparison Grid */
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--zv-bg, #090c12);
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .comparison-grid {
      grid-template-columns: 1fr;
      padding: 1rem;
    }
  }

  .compare-card {
    background: var(--zv-surface, #0f141e);
    border-radius: var(--zv-radius-md, 10px);
    border: 1px solid var(--zv-border, #1e2736);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .compare-card.opt-card {
    border-color: rgba(16, 185, 129, 0.45);
  }

  .card-top-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--zv-surface-elevated, #161d2b);
    border-bottom: 1px solid var(--zv-border, #1e2736);
    min-height: 48px;
  }

  .card-badge { font-size: 0.8125rem; font-weight: 600; }
  .card-badge.raw { color: #fda4af; }
  .card-badge.opt { color: #6ee7b7; }
  .card-token-counter { font-size: 0.8125rem; font-weight: 700; font-family: var(--sl-font-mono); }
  .text-red { color: #fda4af; }
  .text-emerald { color: #34d399; }

  /* Equal-Height Image Stage */
  .image-stage {
    position: relative;
    background: #06080d;
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 360px;
    overflow: hidden;
    flex: 1;
  }

  .crop-stage {
    background: radial-gradient(circle at center, rgba(16, 185, 129, 0.08), #06080d 72%);
  }

  .canvas-viewport-frame {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
    background: #ffffff;
    max-height: 310px;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-image {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .stage-image.full-canvas {
    max-height: 300px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .wiki-desktop-indicator {
    position: absolute;
    left: 28.5%;
    top: 57.0%;
    width: 43.0%;
    height: 8.5%;
    border: 2px dashed #f43f5e;
    background: rgba(244, 63, 94, 0.18);
    border-radius: 4px;
    pointer-events: none;
  }

  .indicator-chip {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    background: #e11d48;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .crop-focus-frame {
    padding: 6px;
    border: 2px solid rgba(16, 185, 129, 0.55);
    border-radius: 8px;
    background: #ffffff;
