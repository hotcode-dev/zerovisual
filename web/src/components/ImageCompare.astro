<script>
  function setupImageCompareTabs() {
    const tabs = document.querySelectorAll('.scenario-tab');
    const contents = document.querySelectorAll('.scenario-content');

    tabs.forEach((tab) => {
      tab.onclick = () => {
        tabs.forEach((t) => t.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));

        tab.classList.add('active');
        const scenario = tab.getAttribute('data-scenario');
        const target = document.getElementById(`scenario-${scenario}`);
        if (target) target.classList.add('active');
      };
    });
  }

  document.addEventListener('DOMContentLoaded', setupImageCompareTabs);
  document.addEventListener('astro:page-load', setupImageCompareTabs);
  setupImageCompareTabs();
</script>
